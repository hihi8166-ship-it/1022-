<script type="text/javascript">

function gf_loadingPopup() {
	$('#loadingPopup').popup({ backdrop:true, backdropClick:false, keyboard:false, positionFixed:true });
}


function gf_checkPopup(title, content, btnName1, btnName2, icon) {
	$("#popTitle").html(title);
	$("#popContent").html(content);
	if(btnName1 != undefined && btnName1 != ""){
		$("#popBtn1").html(btnName1);
		$("#popBtn1").show();
		$("#popBtn2").removeClass("w100");
	} else {
		$("#popBtn1").hide();
		$("#popBtn2").addClass("w100");
	}
	if(btnName2 != undefined && btnName2 != "")
		$("#popBtn2").html(btnName2);
	$('#checkPopup').popup(openOpt);

	lf_popIconSetting('popIcon', icon, "confirmPopBackdrop");
}


function gf_alertPopup(title, content, btnName, icon) {
	$("#popupTitle").html(title);
	$("#popupContent").html(content);
	$("#popupBtn").addClass("w100");
	if(btnName != undefined && btnName != "")
		$("#popupBtn").html(btnName);
	$('#alertPopup').popup(openOpt);

	lf_popIconSetting('popupIcon', icon, "confirmPopBackdrop");
}


function gf_confirmPopClose() {
	gf_closePop("checkPopup");
}


function gf_alertPopClose() {
	gf_closePop("alertPopup");
}


function lf_popIconSetting(iconId, icon, backdropId) {
	if(icon == "notice") {
		$("#"+iconId).removeClass().addClass("icon icon-alert-warning");
	} else if(icon == "info") {
		$("#"+iconId).removeClass().addClass("icon icon-alert-info");
	} else if(icon == "question") {
		$("#"+iconId).removeClass().addClass("icon icon-alert-question");
	} else if(icon == "sorry") {
		$("#"+iconId).removeClass().addClass("icon icon-alert-sorry");
	} else { //confirm
		$("#"+iconId).removeClass().addClass("icon icon-alert-check");
	}
	$("#" + backdropId).css("z-index", "999"); // backdrop 의 z-index 조정...
}

function lf_closeChk(){
	if($("#chk7day").is(":checked")) {
		closeWin('usingPcPop', 7);
	} else {
		closeWin('usingPcPop', 1);
	}
}
</script>


	
	
		
	




