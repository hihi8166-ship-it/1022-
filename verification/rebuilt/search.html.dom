<script type="text/javascript">
    $(function () {
            $('.integration-search-wrap-v6 .tabs ul .tab-item').on(
                'click',
                function () {
                    var tabIndex = $(this).index();
                    $('.integration-search-wrap-v6 .tabs ul .tab-item').removeClass(
                        'active'
                    );
                    $(this).addClass('active');
                    targetAction(tabIndex);
                }
            );

            if (
                $('.integration-search-wrap-v6 .tabs ul .tab-item').hasClass(
                    'active'
                )
            ) {
                var tabIndex = $(
                    '.integration-search-wrap-v6 .tabs ul .tab-item.active'
                ).index();
                targetAction(tabIndex);
            }

            function targetAction(itemIdex) {
                var tScrollX =
                    $('.integration-search-wrap-v6 .tabs ul')
                        .find('.tab-item')
                        .eq(itemIdex)
                        .offset().left +
                    $('.integration-search-wrap-v6 .tabs ul').scrollLeft() +
                    -$(window).width() / 2 +
                    $('.integration-search-wrap-v6 .tabs ul')
                        .find('.tab-item')
                        .eq(itemIdex)
                        .width() /
                    2;
                tScrollX <= 0 ? 0 : tScrollX;
                parseInt(tScrollX) !==
                $('.integration-search-wrap-v6 .tabs ul').scrollLeft() &&
                $('.integration-search-wrap-v6 .tabs ul')
                    .stop()
                    .animate({ scrollLeft: tScrollX }, 500);
            }


    });
    $(window).resize(function() {
        // 브라우저 크기가 변경되었을 때 실행되는 함수
        const width = $(window).width();
        const getSearchType = (new URL(document.location)).searchParams.get("searchType");

        $("#seminarStatus").attr("style", "display: none !important");
        $("#seminarStatusMobile").attr("style", "display: none !important");
        $("#recruitStatus").attr("style", "display: none !important");
        $("#recruitStatusMobile").attr("style", "display: none !important");
        if (width < 992) {
            if (getSearchType === "SEARCH_TY009") {
                $("#recruitStatusMobile").attr("style", "display: flex !important");
            } else if (getSearchType === "SEARCH_TY010") {
                $("#seminarStatusMobile").attr("style", "display: flex !important");
            }
        } else {
            if (getSearchType === "SEARCH_TY009") {
                $("#recruitStatus").attr("style", "display: flex !important");
            } else if (getSearchType === "SEARCH_TY010") {
                $("#seminarStatus").attr("style", "display: flex !important");
            }
        }
    });
</script>

<script type="text/javascript">
    let sortType = '';
    let sortColumn = '';
    let sortDirection = '';
    let searchVal = window.localSearchValue;
    let secondJobFieldCode = '';
    let paramFieldCode = '';
    let detailSearchVal = '';
    let pDetailSearchVal = '';
    let pageNo = 1;
    let expertPageNo = 1;
    let articlePageNo = 1;
    let faqPageNo = 1;
    let recruitPageNo = 1;
    let seminarPageNo = 1;
    let projectPageNo = 1;
    let serviceType = '';
    let searchType = 'SEARCH_TY001';
    let firstJobFieldNm = "";
    let secondJobFieldNm = "";
    let caseTypeCode = '';
    let statusType = '';
    let statusTypeNm = '전체';
    let historyBackFlag = true;
    let recruitFrontStatusCode = "";
    let seminarStatusCode = "";

    window.addEventListener('beforeunload', () => {
        // 페이지 뒤로가기 관련
        sessionStorage.setItem('expertPageNo', expertPageNo);
        sessionStorage.setItem('faqPageNo', faqPageNo); // 현재 페이지
        sessionStorage.setItem('recruitPageNo', recruitPageNo);
        sessionStorage.setItem('seminarPageNo', seminarPageNo);
        sessionStorage.setItem('searchPageScrollY', window.scrollY); // 스크롤 위치
    });

    //재검색 div
    if(pDetailSearchVal != ''){
        let detailToArray = pDetailSearchVal.split(" ");
        for(let i = 0; i < detailToArray.length; i++) {
            let html = '<p class="piece">' + detailToArray[i] + '<a href="javascript:void(0);" onclick="lf_deleteSrchCondition(this);" class="del"></a></p>';
            $(".detail-list-box").append(html);
            if ($("#detailDiv").css("display") == "none") {
                $("#detailDiv").css("display", "flex");
            }
        }
    }

    //결과 내 재검색
    function lf_detailSearch() {
        const detailArr = $(".detail-list-box .piece");
        let detailChk = true;

        if($("#keywordDetail").val().trim() == ""){
            gf_openToastDefault("결과 내 재검색 키워드를 입력하세요.");
        } else {
            //재검색 키워드 chk
            for (item of detailArr) {
                if ($(item).text() == $("#keywordDetail").val()) {
                    detailChk = false;
                }
            }

            //통합검색 키워드 chk
            if (searchVal == $("#keywordDetail").val()) {
                detailChk = false;
            }

            if (detailArr.length < 3) {
                if (!detailChk) {
                    gf_openToastDefault("이미 검색한 키워드를 입력하였습니다.");
                } else {
                    let html = '<p class="piece">' + $("#keywordDetail").val() + '<a href="javascript:void(0);" onclick="lf_deleteSrchCondition(this);" class="del"></a></p>';
                    $(".detail-list-box").append(html);
                    if ($("#detailDiv").css("display") == "none") {
                        $("#detailDiv").css("display", "flex");
                    }

                    $("#keywordDetail").val('');
                    lf_searchList(true); // 전체검색
                    if ($('.tab-item.active').data('field') != 'SEARCH_TY001') {//전체검색탭이 아닐때
                        let tab = $('.tab-item.active').data('field');
                        lf_detailSearchTab(tab);
                    }
                }
            } else {
                gf_openToastDefault("검색 가능 제한 개수(3개)를 초과하였습니다.");
            }
        }
    }

    //결과 내 재검색 삭제
    function lf_deleteSrchCondition(ele) {
        $(ele).parent().remove();

        //재검색 박스 체크
        var pLength = $(".piece").length;
        if(pLength <= 0) {
            $("#detailDiv").css("display", "none");
        }

        lf_searchList(true); // 검색
        if($('.tab-item.active').data('field') != 'SEARCH_TY001'){//전체검색탭이 아닐때
            let tab = $('.tab-item.active').data('field');
            lf_detailSearchTab(tab);
        }
    }

    //전체가 아닌 탭상태에서 결과내 재검색
    function lf_detailSearchTab(tab){
        if(tab =='SEARCH_TY002'){//전문가
            lf_expertSearchList(true);
        }else if(tab == 'SEARCH_TY003'){//프로젝트상품
            productPageNo = 1;
            sessionStorage.setItem('productPageNo', productPageNo);
            sessionStorage.setItem('productPageScrollY', 0);
            lf_productSearchList(true);
        }else if(tab == 'SEARCH_TY004'){//온라인자문
            lf_consultSearchList(true);
        }else if(tab == 'SEARCH_TY005'){//프로젝트공고
            lf_projectSearchList(true);
        }else if(tab == 'SEARCH_TY006'){//성공사례
            lf_successSearchList(true);
        }else if(tab == 'SEARCH_TY007'){//아티클T
            articlePageNo = 1;
            sessionStorage.setItem('articlePageNo', articlePageNo);
            sessionStorage.setItem('articlePageScrollY', 0);
            lf_articleSearchList(true);
        }else if(tab == 'SEARCH_TY008'){//FAQ
            lf_faqSearchList(true);
        }
    }

    // 전체 count
    function lf_allSearchCount(){
        /*let allCnt = parseInt($("#sExpertListCnt").text().replace(/,/g , '')) + parseInt($("#sProductListCnt").text().replace(/,/g , '')) + parseInt($("#sConsultListCnt").text().replace(/,/g , ''))
                + parseInt($("#sProjectListCnt").text().replace(/,/g , '')) + parseInt($("#sRecruitListCnt").text().replace(/,/g , '')) + parseInt($("#sArticleListCnt").text().replace(/,/g , '')) + parseInt($("#sFaqListCnt").text().replace(/,/g , ''));*/
        let allCnt = parseInt($("#sExpertListCnt").text().replace(/,/g , '')) + parseInt($("#sProjectListCnt").text().replace(/,/g , '')) + parseInt($("#sSuccessListCnt").text().replace(/,/g , '')) + parseInt($("#sSeminarListCnt").text().replace(/,/g , '')) + parseInt($("#sArticleListCnt").text().replace(/,/g , '')) + parseInt($("#sFaqListCnt").text().replace(/,/g , ''));
        $("#allListCnt").text(allCnt.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ','));
        sessionStorage.setItem('searchAllCnt', allCnt.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    /**
     * html tag 디스플레이 제어(다중 class는 미구현)
     * selector는 id값으로 해주면 좋음
     * value 는 display 속성 아무거나
     * */
    const lf_displayControl = (selector, value) => {
        document.querySelector(selector).style.display = value;
    };

    const searchTabDiv = document.querySelectorAll(".search-tab-div"); // tab 안에 모든 div

    // tab 누를때, div 전체 숨김
    const lf_searchTabDivNone = () => {
        searchTabDiv.forEach((e, i) => {
            searchTabDiv[i].style.display = "none";
        });
        lf_displayControl('#intergrateSearchDiv', 'none');
    };

    //필터 및 타이틀 동적제어를 위한 함수
    function lf_viewControl(data){
        searchType = data;
        lf_searchTabDivNone(); // tab 영역 내 div 전부 숨김
        lf_jobfieldViewCtrlM(data);

        // 필터 전체숨김(세미나, 인재추천)
        $("#seminarStatus").attr("style", "display: none !important");
        $("#seminarStatusMobile").attr("style", "display: none !important");
        // $("#recruitStatus").attr("style", "display: none !important");
        // $("#recruitStatusMobile").attr("style", "display: none !important");


        if (data =='SEARCH_TY002'){ //전문가
            $("#allListCnt").text(sessionStorage.getItem('searchAllCnt'));
            $("#expertTitleDiv").css("display", "flex");
            $("#expertWrapDiv").css("display", "flex");
            $("#fieldDiv").css("display", "flex");
            //sortColumn = "_score";
            lf_expertSearchList(true);
        } else if(data == 'SEARCH_TY005'){//프로젝트공고
            $("#fieldDiv").css("display", "none");
            $("#allListCnt").text(sessionStorage.getItem('searchAllCnt'));
            $("#projectTitleDiv").css("display", "flex");
            $("#projectWrapDiv").css("display", "block");
            $("#projectSearchUL").css("display", "block");
            $("#projectStatusDiv").css("display", "flex");
            lf_projectSearchList(true);
        } else if(data == 'SEARCH_TY006'){//성공사례
            $("#fieldDiv").css("display", "none");
            $("#allListCnt").text(sessionStorage.getItem('searchAllCnt'));
            if (!false) {
                lf_displayControl('#successStatusDiv', 'block');
                lf_selectSuccessStatus(caseTypeCode, true);
            } else {
                lf_displayControl('#successStatusMobile', 'block');
                lf_selectSuccessStatusMobile(caseTypeCode, true);
                // lf_confirmSuccessStatusMobile(false);
            }
            lf_displayControl('#successStatusDiv', 'flex');
            lf_displayControl('#successWrapDiv', 'block');
            lf_successSearchList(true);
        } else if (data == 'SEARCH_TY007'){ //아티클T
            $("#allListCnt").text(sessionStorage.getItem('searchAllCnt'));
            $("#articleTitleDiv").css("display", "flex");
            $("#articleSearchUL").css("display", "block");
            $("#fieldDiv").css("display", "none");
            lf_articleSearchList(true);
        } else if (data == 'SEARCH_TY008'){ //FAQ
            $("#allListCnt").text(sessionStorage.getItem('searchAllCnt'));
            if (!false) {
                $("#faqWrapDiv").css("display", "flex");
            } else {
                $("#faqTypeMobile").css("display", "block");
            }
            $("#fieldDiv").css("display", "none");
            $("#faqUserTypeLabel").css("display", "flex");
            $("#faqTitleDiv").css("display", "flex");
            $("#faqSearchDiv").css("display", "block");
            $('#faqUserType .tab-item')[0].click();
            lf_faqSearchList(true);
        } else if (data === 'SEARCH_TY009') { //인재채용
            $("#fieldDiv").css("display", "none");
            $("#allListCnt").text(sessionStorage.getItem('searchAllCnt'));
            $("#recruitTitleDiv").css("display", "flex");
            $("#recruitWrapDiv").css("display", "block");
            if ($(window).width() > 991) {
                $("#recruitStatus").attr("style", "display: flex !important");
            }else {
                $("#recruitStatusMobile").attr("style", "display: flex !important");
            }
            lf_recruitSearchList(true);
        } else if (data === 'SEARCH_TY010') { // 세미나
            $("#fieldDiv").css("display", "none");
            $("#allListCnt").text(sessionStorage.getItem('searchAllCnt'));
            $("#seminarTitleDiv").css("display", "flex");
            $("#seminarWrapDiv").css("display", "block");
            if ($(window).width() > 991) {
                $("#seminarStatus").attr("style", "display: flex !important");
            }else {
                $("#seminarStatusMobile").attr("style", "display: flex !important");
            }
            lf_seminarSearchList(true);
        } else { //전체
            $("#fieldDiv").css("display", "none");
            $("#intergrateSearchDiv").css("display", "block");
            //sortColumn = "_score";
            lf_searchList(true);
        }
    }

    // 검색
    function lf_searchList(initFlag, type) {
        gf_showSearchSpinner();
        //초기화 검색
        if(initFlag) {
            pageNo = 1;
            $("#pageNo").text(1);
        }

        if(sortType == "") sortType = "sortType00";
        if(sortColumn == "") sortColumn = "tb_referral_confirm_type_code";
        if(sortDirection == "") sortDirection = "desc";

        // 결과 내 재검색
        detailSearchVal = "";
        $(".piece").each(function(i, v){
            detailSearchVal += $(v).text() + " ";
        });
        detailSearchVal = detailSearchVal.trim();

        searchParam = {
            sortType 								: sortType
            ,pageNo  								: pageNo
            ,serviceType 							: serviceType
            ,firstJobFieldCode  					: ''
            ,secondJobFieldCode 					: secondJobFieldCode
            ,servicePaymentHourPriceCode 			: ''
            ,servicePaymentDayPriceCode  			: ''
            ,searchTag   							: ''
            ,searchValue 							: searchVal
            ,initFlag    							: initFlag
            ,keywordFilter							: ''
            ,keywordDetail							: detailSearchVal
            ,sortColumn								: sortColumn
            ,sortDirection							: sortDirection
        };


        // 통합검색 ajax
        $.ajax({
            url : "/common/ajax/integrateSearchListAjax"
            ,type : "POST"
            ,data : searchParam
            ,dataType : "html"
            ,success : function(data) {
                // So, globalError 페이지의 'SYSTEM ERROR' 문구를 확인하여 에러 alert을 팝업
                if(!data.match('class="local-name">SYSTEM ERROR')) {
                    $("#intergrateSearchDiv").html(data);
                    lf_allSearchCount();
                    lf_expandFaqDetail();
                }

                gf_hideSearchSpinner();
            }
            ,error : function() {
                gf_hideSearchSpinner();
                gf_checkPopup("오류가 발생했어요","잠시 후 다시 이용해주세요.<br>계속해서 오류가 발생하면<br>고객센터(tbhelp@talentbank.co.kr)로 연락해주세요.","","확인", "sorry");
                $("#popBtn2").off().on('click', gf_confirmPopClose);
            }
            ,complete: function () {
                if (historyBackFlag === true && window.performance.getEntriesByType('navigation')[0].type === 'back_forward') {
                    window.scrollTo({ top: sessionStorage.getItem('searchPageScrollY') });
                    historyBackFlag = false;
                }
            }
        });

        //history replace
        lf_urlSetting(searchType);

        // setTimeout(function () {
        // 	lf_allSearchCount();
        // }, 2500);

    }

    /*if(typeof(history.replaceState) == "function") {
        history.replaceState(null, "", location.href.split("?")[0]+"?searchValue=" + searchVal +"&searchType="+searchType+ "&sortType=" + sortType +"&sortColumn=" + sortColumn + "&sortDirection=" + sortDirection + "&keywordDetail=" + detailSearchVal + "&secondJobFieldCode=" + secondJobFieldCode);
    }*/

    //전문분야 재검색
    function lf_selectJobField(parentJobField, ele, param) {
        if(ele != ''){
            //상세분야 list 선택시
            pageNo = 1;
            productPageNo = 1;
            expertPageNo = 1;
            sessionStorage.setItem('expertPageNo', expertPageNo);
            //sessionStorage.setItem('searchPageNo', pageNo);
            sessionStorage.setItem('searchPageScrollY', 0);
            sessionStorage.setItem('productPageNo', productPageNo);
            sessionStorage.setItem('productPageScrollY', 0);
            $(ele).parent().siblings('li').removeClass("active");
            $(ele).parent().addClass("active"); // 선택값만 active
        } else {
            //상세분야 파라미터로 넘어왔을 경우
            const fieldLI = document.querySelectorAll("[data-jobfield]");
            fieldLI.forEach((e, i) => {
                $(e).removeClass("active");
                if($(e).data("jobfield") == parentJobField){
                    $(e).addClass("active");
                }
            });
        }

        if(parentJobField == ''){
            //전문분야 전체선택
            $("#detailFieldDiv").css("display", "none");
            secondJobFieldCode = '';
            lf_viewControl($('.tab-item.active').data('field'));
        } else {
            //전문분야 선택이 들어갔을때
            $.ajax({
                url : "/common/ajax/getJobField2List?parentJobFieldCode="+parentJobField
                ,method : "get"
                ,dataType : "json"
                ,contentType: "application/json"
                ,cache : false
                ,success : function(data) {
                    var str = "";
                    $(data).each(function(i, v) {
                        if(param != ''){
                            //검색된 전문분야코드가 존재할때 해당분야 자동검색
                            if(v.jobFieldCode == param){
                                str += "<li class='active' data-jobfield=''><a href='javascript:void(0)' onclick='lf_selectDetailJobField(\"" + v.jobFieldCode + "\",this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
                                secondJobFieldCode = v.jobFieldCode;
                                lf_viewControl($('.tab-item.active').data('field'));
                            } else {
                                str += "<li><a href='javascript:void(0)' onclick='lf_selectDetailJobField(\""+ v.jobFieldCode + "\",this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
                            }
                        } else {
                            if(i==0) {
                                //1depth 분야를 선택했을 경우 2depth 상세전체분야를 자동검색
                                str += "<li class='active'><a href='javascript:void(0)' onclick='lf_selectDetailJobField(\"" + v.jobFieldCode + "\",this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
                                secondJobFieldCode = v.jobFieldCode;
                                lf_viewControl($('.tab-item.active').data('field'));
                            } else {
                                str += "<li><a href='javascript:void(0)' onclick='lf_selectDetailJobField(\""+ v.jobFieldCode + "\",this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
                            }
                        }
                    });

                    $("#detailFieldUL").html(str);
                    $("#detailFieldDiv").css("display", "block");

                    //통합검색 전문분야 선택 스크롤 PC
                    var chkList = $(".category-section .check-list , .category-popup .check-list").eq(0);
                    var activeIdx = chkList.find("li.active").index();
                    var FieldHeight =  chkList.find("li").height();
                    chkList.animate({scrollTop: activeIdx * FieldHeight }, 1000);
                    chkList.find(".scroll").animate({scrollTop: activeIdx * FieldHeight }, 1000);

                }
                ,error : function(data) {
                    gf_checkPopup("오류가 발생했어요","잠시 후 다시 이용해주세요.<br>계속해서 오류가 발생하면<br>고객센터(tbhelp@talentbank.co.kr)로 연락해주세요.","","확인", "sorry");
                    $("#popBtn2").off().on('click', gf_confirmPopClose);
                }
            });
        }
    }

    //상세분야 재검색
    function lf_selectDetailJobField(field, ele){
        if(ele != '') {
            $(ele).parent().siblings('li').removeClass("active");
            $(ele).parent().addClass("active"); // 선택값만 active
        }
        secondJobFieldCode = field;
        pageNo = 1;
        productPageNo = 1;
        expertPageNo = 1;
        sessionStorage.setItem('expertPageNo', expertPageNo);
        //sessionStorage.setItem('searchPageNo', pageNo);
        sessionStorage.setItem('searchPageScrollY', 0);
        sessionStorage.setItem('productPageNo', productPageNo);
        sessionStorage.setItem('productPageScrollY', 0);
        lf_viewControl($('.tab-item.active').data('field'));
    }

    //전문분야 클릭시 비동기 호출
    function lf_selectAsyncSearch(searchType){
        lf_jobfieldViewCtrlM(searchType);
        if(searchType =='SEARCH_TY002'){//전문가
            lf_expertSearchList(true);
        }else if(searchType == 'SEARCH_TY005'){//프로젝트공고
            lf_projectSearchList(true);
        }else if(searchType == 'SEARCH_TY006'){//성공사례
            lf_successSearchList(true);
        }else if(searchType == 'SEARCH_TY007'){//아티클T
            lf_articleSearchList(true);
        }else if(searchType == 'SEARCH_TY008'){//FAQ
            lf_faqSearchList(true);
        } else if (searchType === 'SEARCH_TY009') {//인재추천공고
            lf_recruitSearchList(true);
        } else{//전체
            lf_searchList(true);
        }
    }

    //정렬 재검색
    function lf_sortList(sortVal){

        if(sortVal == "sortType01"){
            //평점높은순
            sortType = "sortType01";
            sortColumn = "expert_rating";
            sortDirection = "desc";
        } else if(sortVal == "sortType02"){
            //평점개수많은순
            sortType = "sortType02";
            sortColumn = "rating_cnt";
            sortDirection = "desc";
        } else if(sortVal == "sortType03"){
            //표준대금 낮은순 (1시간)
            sortType = "sortType03";
            sortColumn = "project_wish_price_hours";
            sortDirection = "asc";
        } else if(sortVal == "sortType04"){
            //표준대금 낮은순 (1일)
            sortType = "sortType04";
            sortColumn = "project_wish_price_day";
            sortDirection = "asc";
        } else {
            //정확도순
            sortType = "sortType00";
            sortColumn = "_score";
            sortDirection = "desc";
        }
        lf_expertSearchList(true); // 검색
    }

    //전문분야 초기화
    function lf_clearField(){
        secondJobFieldCode = '';
        $("#fieldLI").siblings('li').removeClass("active");
        $("#fieldLI").addClass("active");
        $("#detailFieldDiv").css("display", "none");

        productPageNo = 1;
        sessionStorage.setItem('productPageNo', productPageNo);
        sessionStorage.setItem('productPageScrollY', 0);

        var isMobile = false;
        if(isMobile){
            lf_selectJobField_M('', '', '', '');
        }else{
            lf_selectJobField('', '', '');
        }
    }

    $(function() {
        lf_init();
    });

    function lf_init() {
        // 이미 검색된 전문분야 코드가 있다면 div set.

        if(paramFieldCode != ""){
            // 이미 검색된 전문상세분야의 1depth 분야 체크후 리스트 set.
            let pField = paramFieldCode.substr(0, 8);
            var isMobile = false;
            if(isMobile){
                lf_selectJobField_M('', pField, '', paramFieldCode);
            }else{
                lf_selectJobField(pField, '', paramFieldCode);
            }
        }else{
            lf_viewControl(searchType);
        }
    }

    // 검색
    function lf_expertSearchList(initFlag) {
        gf_showSearchSpinner();

        // 페이지 set.
        //$("#expertPageNo").text(pageNo);
        $("#expertPageNo").text(expertPageNo);

        if(sortType == "") sortType = "sortType00";
        if(sortColumn == "") sortColumn = "tb_referral_confirm_type_code";
        if(sortDirection == "") sortDirection = "desc";

        // 결과 내 재검색
        detailSearchVal = "";
        $(".piece").each(function(i, v){
            detailSearchVal += $(v).text() + " ";
        });
        detailSearchVal = detailSearchVal.trim();

        searchParam = {
            sortType 								: sortType
            ,pageNo  								: expertPageNo
            ,serviceType 							: serviceType
            ,firstJobFieldCode  					: ''
            ,secondJobFieldCode 					: secondJobFieldCode
            ,servicePaymentHourPriceCode 			: ''
            ,servicePaymentDayPriceCode  			: ''
            ,searchTag   							: ''
            ,searchValue 							: searchVal
            ,initFlag    							: initFlag
            ,keywordFilter							: ''
            ,keywordDetail							: detailSearchVal
            ,sortColumn								: sortColumn
            ,sortDirection							: sortDirection
        };

        // 전문가 검색(+ 건수)
        $.ajax({
            url : "/common/ajax/expertSearchListAjax"
            ,type : "POST"
            ,data : searchParam
            ,dataType : "html"
            ,success : function(data) {
                // 공통 Error 처리가 된다면 기존페이지에 globalError.jsp 페이지가 append 가 되어 화면이 깨짐
                // So, globalError 페이지의 'SYSTEM ERROR' 문구를 확인하여 에러 alert을 팝업
                if(!data.match('class="local-name">SYSTEM ERROR')) {
                    if(initFlag == true){
                        $("#expertSearchUL").html(data);
                        // 뒤로가기로 돌아왔을 때 감지
                        // if (window.performance.navigation.type == 2) {
                        // 	window.scrollTo(0, sessionStorage.getItem('searchPageScrollY'));
                        // }
                    } else {
                        $("#expertSearchUL").append(data);
                    }
                    gf_hideSearchSpinner();
                } else{
                    $("#expertListCnt").text("0");
                    $("#expertErrDataDiv").css("display", "block");
                    $("#expertSearchUL").css("display", "none");
                    $("#expertNoDataDiv").css("display", "none");
                    gf_hideSearchSpinner();
                }
            }
            ,error : function() {
                $("#expertListCnt").text("0");
                $("#expertErrDataDiv").css("display", "block");
                $("#expertSearchUL").css("display", "none");
                $("#expertNoDataDiv").css("display", "none");
                gf_hideSearchSpinner();
            }
            ,complete: function () {
                if (historyBackFlag === true && window.performance.getEntriesByType('navigation')[0].type === 'back_forward') {
                    window.scrollTo({ top: sessionStorage.getItem('searchPageScrollY') });
                    historyBackFlag = false;
                }
            }
        });

        //history replace
        lf_urlSetting(searchType);

    }

    // 프로젝트 공고 검색
    function lf_projectSearchList(initFlag) {
        gf_showSearchSpinner();

        // 페이지 표시
        $("#projectPageNo").text(projectPageNo);

        // 결과 내 재검색 문자열 만들기
        let detailSearchVal = $(".piece").map(function() { return $(this).text(); }).get().join(" ").trim();

        // 모든 값은 '값'으로! (jQuery 객체 금지)
        const safeSearchVal = typeof searchVal === 'string'
            ? searchVal
            : ($('#keywordDetail').length ? String($('#keywordDetail').val() ?? '') : String(searchVal ?? ''));

        const safeStatusType = typeof statusType === 'string'
            ? statusType
            : ($('#statusType').length ? String($('#statusType').val() ?? '') : String(statusType ?? ''));

        const data = {
            pageNo: Number(projectPageNo) || 1,
            searchValue: safeSearchVal,        // ← 문자열로 보장
            initFlag: !!initFlag,              // ← 불리언으로 보장
            keywordFilter: '',
            keywordDetail: detailSearchVal,    // ← 문자열
            projectStatusCode: safeStatusType  // ← 문자열
        };

        // 디버깅에 도움: 직렬화 전 타입 확인
        // console.log('ajax data =', data);

        $.ajax({
            url: "/common/ajax/projectSearchListAjax",
            type: "POST",
            data: data,          // ← 순수 POJO만 전달
            dataType: "html",
            // traditional: true, // 서버가 배열을 a=b&a=c 형태로 원하면 사용
            success: function (html) {
                if (!html.match('class="local-name">SYSTEM ERROR')) {
                    if (initFlag === true) {
                        $("#projectSearchUL").html(html);
                    } else {
                        $("#projectSearchUL").append(html);
                    }
                } else {
                    $("#projectListCnt").text("0");
                    $("#projectErrDataDiv").show();
                    $("#projectNoDataDiv, #projectSearchUL").hide();
                }
                gf_hideSearchSpinner();
            },
            error: function () {
                $("#projectListCnt").text("0");
                $("#projectErrDataDiv").show();
                $("#projectNoDataDiv, #projectSearchUL").hide();
                gf_hideSearchSpinner();
            }
        });

        // history replace
        lf_urlSetting(searchType);
    }


    // 성공사례 탭 검색
    /** 성공사례 유형 선택 PC */
    const lf_selectSuccessStatus = (_caseTypeCode, initFlag) => {
        const $statusOptionTabActive = document.querySelector('#successStatusOptionTab .active');
        const $statusOptionTabLi = document.querySelectorAll('#successStatusOptionTab li');

        $statusOptionTabActive.classList.remove('active');

        const findActive = [...$statusOptionTabLi].filter((item) => {
            return item.dataset.code === _caseTypeCode;
        });
        findActive[0].className = 'active';

        if (!initFlag) {
            caseTypeCode = _caseTypeCode;
            lf_successSearchList(true);
        }
    }

    const lf_successSearchList = (initFlag) => {
        gf_showSearchSpinner();
        if (initFlag) successPageNo = 1;

        // 결과 내 재검색
        detailSearchVal = "";
        $(".piece").each(function (i, v) {
            detailSearchVal += $(v).text() + " ";
        });
        detailSearchVal = detailSearchVal.trim();

        searchParam = {
            pageNo: successPageNo,
            searchValue: searchVal,
            serviceType: serviceType,
            initFlag: initFlag,
            keywordFilter: '',
            keywordDetail: detailSearchVal,
            caseTypeCode: caseTypeCode,
        };

        const data = {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(searchParam),
        };
        lf_getData('/common/ajax/successSearchListAjax', data)
            .then((result) => {
                if (result.rowCnt < 1) {
                    const successPostsDiv = document.querySelector('#successPostsDiv > .no-data');
                    successPostsDiv.style.display = 'block';
                    document.querySelector('#successPostsDiv > ul').style.display = 'none';
                    document.querySelector('#successPostsDiv > .more-data').style.display = 'none';
                    successPostsDiv.innerHTML = lf_noData();
                } else {
                    let html = '';
                    const caseTypeCodeClass = {
                        'CS_TY001': 'badge-client',
                        'CS_TY002': 'badge-client-dark',
                        'CS_TY003': 'badge-consultation02',
                        'CS_TY004': 'badge-consultation02',
                    };
                    for (let item of result.successList) {
                        html += `
					<li class="posts-item" onclick="javascript:location.href='story.html?successCaseSeq=${item.successCaseSeq}'">
						<div class="posts-head">
							<div class="info-area">
								<span class="badge badge-lg badge-pill ${caseTypeCodeClass[item.caseTypeCode]}">${item.caseTypeCodeName}</span>
								<span class="badge badge-lg badge-pill posts-type">${item.jobType}</span>
							</div>
							<span class="posts-name"><a href="javascript:void(0);" class="text">${item.title}</a></span>
						</div>
						<div class="posts-body">
							<div class="data-text2">
								<a href="javascript:void(0);" class="body">
									<strong>기업 고객 의뢰 내용</strong> -
									${item.projectSummary}
								</a>
							</div>
						</div>
					</li>
					`;
                    }

                    const successPostsUlDiv = document.querySelector('#successPostsDiv > ul');
                    document.querySelector('#successPostsDiv > .no-data').style.display = 'none';
                    successPostsUlDiv.style.display = 'block';
                    document.querySelector('#successPostsDiv > .more-data').style.display = 'block';

                    if (initFlag) {
                        successPostsUlDiv.innerHTML = html;
                    } else {
                        successPostsUlDiv.insertAdjacentHTML('beforeend', html);
                    }

                }
                // 더보기 버튼 제어
                document.querySelector('#successPostsDiv > .more-data').style.display = result.moreYn === 'Y' ? 'block' : 'none';
                if (result.moreYn === 'Y') {
                    document.querySelector('#successPageNo').textContent = successPageNo;
                    document.querySelector('#successTotPageNo').textContent = result.pageTotal;
                }

                // 검색된 개수
                document.querySelector('#successTitleDiv span.num').textContent = result.rowCnt;
            })
            .catch(() => { // error 처리
                document.querySelector('#successTitleDiv span.num').textContent = '0';
                const successPostsDiv = document.querySelector('#successPostsDiv > .no-data');
                successPostsDiv.style.display = 'block';
                document.querySelector('#successPostsDiv > ul').style.display = 'none';
                document.querySelector('#successPostsDiv > .more-data').style.display = 'none';
                successPostsDiv.innerHTML = lf_listError();
            }).finally(() => { // 최종
            gf_hideSearchSpinner();
            lf_urlSetting(searchType);
            if (historyBackFlag === true && window.performance.getEntriesByType('navigation')[0].type === 'back_forward') { // 뒤로가기 감지
                for (let i = 1; i < sessionStorage.getItem('successPageNo'); i++) {
                    successPageNo = i + 1;
                    lf_successSearchList(false);
                }
                window.scrollTo(0, sessionStorage.getItem('searchPageScrollY'));
                historyBackFlag = false;
            }
        });
    };

    /** 성공사례 유형 선택 모바일 */
    const lf_selectSuccessStatusMobile = (_caseTypeCode, initFlag) => {
        const $statusOptionTabActive = document.querySelector('#successStatusMobileUl .active');
        const $statusOptionTabLi = document.querySelectorAll('#successStatusMobileUl li');

        if (!initFlag) caseTypeCode = _caseTypeCode;
        $statusOptionTabActive.classList.remove('active');

        const findActive = [...$statusOptionTabLi].filter((item) => {
            return item.dataset.code === _caseTypeCode;
        });
        findActive[0].className = 'active';
    };

    /** 성공사례 유형 최종 선택 버튼 모바일 */
    const lf_confirmSuccessStatusMobile = (initFlag) => {
        const selectStatusName = document.querySelector('#successStatusMobileUl .active').textContent;
        document.querySelector('#successStatusMobile span').textContent = selectStatusName;
        document.querySelector('#successStatusMobile > div > a').classList.remove('active');
        document.querySelector('#successStatusMobile > div > a').textContent = '변경';

        if (initFlag) {
            $('#categoryPopupSuccess button.close').click();
            lf_successSearchList(true);
        }
    };

    /** 성공사례 유형 선택 초기화 모바일 */
    const lf_successStatusResetMobile = () => {
        const $statusOptionTabActive = document.querySelector('#successStatusMobileUl .active');
        const $statusOptionTabLi = document.querySelectorAll('#successStatusMobileUl li');

        caseTypeCode = '';
        $statusOptionTabActive.classList.remove('active');

        const findActive = [...$statusOptionTabLi].filter((item) => {
            return item.dataset.code === '';
        });
        findActive[0].className = 'active';
    }

    // 성공사례 더보기 버튼
    const lf_successMoreBtn = () => {
        let pageNum = document.querySelector('#successPageNo').textContent;
        pageNum++;
        successPageNo = pageNum;
        lf_successSearchList(false); // 검색
    };

    // 아티클T 검색
    function lf_articleSearchList(initFlag) {
        gf_showSearchSpinner();
        if(initFlag) articlePageNo = 1;
        $("#articlePageNo").text(articlePageNo);
        var serviceType = '';

        // 결과 내 재검색
        detailSearchVal = "";
        $(".piece").each(function(i, v){
            detailSearchVal += $(v).text() + " ";
        });
        detailSearchVal = detailSearchVal.trim();

        searchParam = {
            sortType 								: ''
            ,pageNo  								: articlePageNo
            ,serviceType 							: serviceType
            ,firstJobFieldCode  					: ''
            ,secondJobFieldCode 					: ''
            ,servicePaymentHourPriceCode 			: ''
            ,servicePaymentDayPriceCode  			: ''
            ,searchTag   							: ''
            ,searchValue 							: searchVal
            ,initFlag    							: initFlag
            ,keywordFilter							: ''
            ,keywordDetail							: detailSearchVal
            ,sortColumn								: ''
            ,sortDirection							: ''
        };

        // 아티클T 검색(+ 건수)
        $.ajax({
            url : "/common/ajax/articleSearchListAjax"
            ,type : "POST"
            ,data : searchParam
            ,dataType : "html"
            ,success : function(data) {
                // 공통 Error 처리가 된다면 기존페이지에 globalError.jsp 페이지가 append 가 되어 화면이 깨짐
                // So, globalError 페이지의 'SYSTEM ERROR' 문구를 확인하여 에러 alert을 팝업
                if(!data.match('class="local-name">SYSTEM ERROR')) {
                    if(articlePageNo == 1){
                        $("#articleSearchLI").html(data);
                    }else{
                        $("#articleSearchLI").append(data);
                    }

                    gf_closeLoading();
                    $("#dataList").css("display", "block");

                    // 뒤로가기로 돌아왔을 때 감지 || 탭 클릭이동&&pageNo 저장시
                    var memoryPageNo = sessionStorage.getItem('articlePageNo') * 1;
                    if (window.performance.navigation.type == 2 || memoryPageNo>1) {
                        for (var i = articlePageNo + 1; i < memoryPageNo + 1; i++) {
                            articlePageNo = i;
                            lf_articleSearchList(false);
                        }
                    }
                } else{
                    $("#articleNum").text("0");
                    $("#articleErrDataDiv").css("display", "block");
                    $("#articleNoDataDiv").css("display", "none");
                    $("#articleSearchLI").css("display", "none");
                    $("#articleMoreBtn").css("display", "none");
                }
                gf_hideSearchSpinner();
            }
            ,error : function() {
                $("#articleNum").text("0");
                $("#articleErrDataDiv").css("display", "block");
                $("#articleNoDataDiv").css("display", "none");
                $("#articleSearchLI").css("display", "none");
                $("#articleMoreBtn").css("display", "none");
                gf_hideSearchSpinner();
            }
        });

        //history replace
        lf_urlSetting(searchType);
    }

    function lf_moreArticleList(){
        var pageNum = parseInt($("#articlePageNo").text());
        var totPageNo = parseInt($("#articleTotPageNo").text());
        pageNum++;

