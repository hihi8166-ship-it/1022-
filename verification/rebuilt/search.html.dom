    const lf_noData = () => {
        const html = `
		<p class="head">
			<span class="block">조건에 맞는 검색결과가 없습니다.</span>
		</p>
		<ul class="clist">
			<li><span>다른 검색어를 입력해보세요.</span></li>
			<li><span>재검색 키워드 수를 줄여보세요.</span></li>
			<li><span>검색조건이 정확한지 확인해 보세요.</span></li>
		</ul>
		`;
        return html;
    }

    const lf_listError = () => {
        const html = `
		<p class="head">
			<span class="block">요청 하신 검색 결과를 불러 올 수 없습니다.<br>잠시 후 다시 시도해 주세요.</span>
		</p>
		<p class="body">동일한 문제가 지속적으로 발생하는 경우<br>고객센터(tbhelp@talentbank.co.kr)로 문의하시기 바랍니다.</p>
		`;
        return html;
    }

    // 뒤로가기로 돌아왔을 때 감지
    if (window.performance.getEntriesByType('navigation')[0].type === 'back_forward') {
        expertPageNo = sessionStorage.getItem('expertPageNo');
        window.scrollTo(0, sessionStorage.getItem('searchPageScrollY'));
    } else {
        scrollInit = true;
        expertPageNo = 1;
        //pageNo = 1;
        lf_setScroll();
    }

    // 처음 스크롤 위치 지정 이후에는 초기화 하지 않음
    var scrollInit = true;

    function lf_setScroll() {
        if (scrollInit) {
            $(document).scrollTop(sessionStorage.searchPageScrollY);
            scrollInit = false;
        }
    }

    function lf_jobfieldViewCtrlM(searchType){
        let isMobile = false;
        if (isMobile == true && (searchType =='SEARCH_TY002' || searchType =='SEARCH_TY003' || searchType =='SEARCH_TY004')) {
            $("#jobfieldMobile").css("display", "block");
        }else{
            $("#jobfieldMobile").css("display", "none");
        }

        if (isMobile == true && searchType =='SEARCH_TY005') {
            $("#prjStatusCategoryMobile").css("display", "block");
        }else{
            $("#prjStatusCategoryMobile").css("display", "none");
        }
    }

    function lf_expandFaqDetail(){
        $('.faq-list h4 a').off();
        $('.faq-list h4 a').click(function(){
            if ($(this).hasClass('active')) {
                $('.faq-list h4 a').removeClass('active');
                $('.faq-list-content').stop().slideUp();
            } else {
                $('.faq-list h4 a').removeClass('active');
                $('.faq-list-content').stop().slideUp();
                $(this).addClass('active');
                $(this).parent().next('.faq-list-content').stop().slideDown();
            }
            return false;
        });
    }

    /** 비동기 통신 */
    const lf_getData = async (url, data) => {
        const response = await fetch(url, data) // fetch api
        const result = await response.json();  // json 형태로 response
        return result;
    };

    /** url 세팅
     * @param searchType
     * */
    const lf_urlSetting = (tabType) => {
        let url = `${location.href.split("?")[0]}`;
        let separator = '?';

        // 공통
        if (lf_notNull(searchVal)) {
            url += `${separator}searchValue=${searchVal}`;
            separator = '&';
        }
        if (lf_notNull(searchType)) {
            url += `${separator}searchType=${searchType}`;
            separator = '&';
        }

        if (lf_notNull(detailSearchVal)) {
            url += `${separator}keywordDetail=${detailSearchVal}`;
            separator = '&';
        }

        // 전체, 전문가, 프로젝트상품, 온자, 성공사례
        if (tabType == 'SEARCH_TY001' || tabType == 'SEARCH_TY002' || tabType == 'SEARCH_TY003' || tabType == 'SEARCH_TY004' || tabType == 'SEARCH_TY006') {
            if (lf_notNull(sortType)) {
                url += `${separator}sortType=${sortType}`;
                separator = '&';
            }
            if (lf_notNull(sortColumn)) {
                url += `${separator}sortColumn=${sortColumn}`;
                separator = '&';
            }
            if (lf_notNull(sortDirection)) {
                url += `${separator}sortDirection=${sortDirection}`;
                separator = '&';
            }
        }

        // 전체, 전문가, 프로젝트상품, 온자
        if (tabType == 'SEARCH_TY001' || tabType == 'SEARCH_TY002' || tabType == 'SEARCH_TY003' || tabType == 'SEARCH_TY004') {
            if (lf_notNull(secondJobFieldCode)) {
                url += `${separator}secondJobFieldCode=${secondJobFieldCode}`;
                separator = '&';
            }
        }

        // 프로젝트공고
        if (tabType == 'SEARCH_TY005') {
            if (lf_notNull(statusType)) {
                url += `${separator}projectStatusCode=${statusType}`;
                separator = '&';
            }
        }

        // 성공사례
        if (tabType == 'SEARCH_TY006') {
            if (lf_notNull(caseTypeCode)) {
                url += `${separator}caseTypeCode=${caseTypeCode}`;
                separator = '&';
            }
        }

        // 인재추천
        if (tabType == 'SEARCH_TY009') {
            if (lf_notNull(recruitFrontStatusCode)) {
                url += `${separator}recruitFrontStatusCode=${recruitFrontStatusCode}`;
                separator = '&';
            }
        }

        // 세미나
        if (tabType == 'SEARCH_TY010') {
            if (lf_notNull(seminarStatusCode)) {
                url += `${separator}seminarStatusCode=${seminarStatusCode}`;
                separator = '&';
            }
        }

        history.replaceState(null, "", url);
    }

    /** null, undefined, '' 체크 */
    const lf_notNull = (data) => {
        return (data == undefined || data == null || data == '') ? false : true;
    }

    function lf_moveArticle(url){
        var userAgent = (navigator.userAgent || navigator.vendor || window.opera).toLowerCase();

        if (/ip(ad|hone|od)/.test(userAgent)) {
            //window.location.href = url;
            const tempDom = document.createElement('a');
            tempDom.setAttribute('href', url);
            tempDom.setAttribute('target', '_blank');
            tempDom.click()
        }else{
            const openNewWindow = window.open("about:blank");
            openNewWindow.location.href = url;
        }
    }

    // 인재추천 검색
    function lf_recruitSearchList(initFlag) {
        gf_showSearchSpinner();
        if (initFlag) recruitPageNo = 1;

        // 결과 내 재검색
        detailSearchVal = "";
        $(".piece").each(function (i, v) {
            detailSearchVal += $(v).text() + " ";
        });
        detailSearchVal = detailSearchVal.trim();

        searchParam = {
            pageNo: recruitPageNo,
            searchValue: searchVal,
            serviceType: serviceType,
            initFlag: initFlag,
            keywordFilter: '',
            keywordDetail: detailSearchVal,
            startPage: (recruitPageNo - 1) * 20,
            recruitFrontStatusCode: recruitFrontStatusCode,
            endPage: 20,
        };

        const data = {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(searchParam),
        };
        lf_getData('/common/ajax/recruitSearchListAjax', data)
            .then((result) => {
                if (result.recruitListCnt < 1) {
                    const recruitPostsDiv = document.querySelector('#recruitPostsDiv > .no-data');
                    recruitPostsDiv.style.display = 'block';
                    document.querySelector('#recruitPostsDiv > ul').style.display = 'none';
                    document.querySelector('#recruitPostsDiv > .more-data').style.display = 'none';
                    recruitPostsDiv.innerHTML = lf_noData();
                } else {
                    let html = '';
                    // 인재추천 공고 상태에 따른 class 객체
                    const statusCodeName = {
                        'REC_ST_001': {
                            className: 'badge-client',
                            name: '수주/계약'
                        },
                        'REC_ST_002': {
                            className: 'badge-client',
                            name: '추천중', //인재서치
                        },
                        'REC_ST_003': {
                            className: 'badge-client',
                            name: '추천중', //인재추천
                        },
                        'REC_ST_004': {
                            className: 'badge-interruption',
                            name: '모집완료', //채용성공
                        },
                        'REC_ST_005': {
                            className: 'badge-interruption',
                            name: '모집완료', //완료
                        },
                        'REC_ST_006': {
                            className: 'badge-interruption',
                            name: '중단(Drop)'
                        },
                    };
                    [...result.recruitList]
                        .filter(item => item.recruitStatusCode !== 'REC_ST_001' && item.recruitStatusCode !== 'REC_ST_006')
                        .map((item) => {
                            html += `
					<li class="posts-item" onclick="javascript:location.href='/common/recruitView?recruitSeq=${item.recruitSeq}'">
						<div class="posts-rows">
							<div class="posts-cols posts-data">
								<div class="posts-main">
									<div class="posts-head">
										<div class="posts-sort">
											<span class="badge badge-lg ${statusCodeName[item.recruitStatusCode].className}">${statusCodeName[item.recruitStatusCode].name}</span>
											<span class="update">${item.noticeStartDate} ~ ${item.noticeEndDate}</span>
										</div>
										<div class="posts-name">
											<a href="#" class="text">${item.title}</a>
										</div>
									</div>
									<!--<div class="posts-foot">
										<div class="posts-info">
											<a href="#" class="link-wrap">
												<div class="info-area">
													<span class="info-item expert-field">포지션명: ${item.positionName}</span>
													<span class="info-item expert-field">합격축하금 500,000원</span>
													<span class="info-item expert-field">추천인 보상제도 진행</span>
												</div>
											</a>
										</div>
									</div>-->
                                    <!-- posts-foot -->
                                    <div class="posts-foot">
                                      <div class="posts-info">
                                        <a href="#" class="link-wrap">
                                          <div class="info-area">
                                            <div class="info-item expert-field">
                                              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"> <g id="icon_&#237;&#143;&#172;&#236;&#167;&#128;&#236;&#133;&#152;&#235;&#170;&#133;" clip-path="url(#clip0_175_4361)"> <path id="Vector" d="M14.6117 11.537C16.5653 7.88577 15.1892 3.34212 11.538 1.38846C7.88677 -0.565195 3.34312 0.810939 1.38946 4.46215C-0.564195 8.11335 0.811939 12.657 4.46315 14.6107C8.11435 16.5643 12.658 15.1882 14.6117 11.537Z" stroke="#404040" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_2" d="M7.99978 8.89166C9.47476 8.89166 10.6705 7.69595 10.6705 6.22098C10.6705 4.746 9.47476 3.55029 7.99978 3.55029C6.52481 3.55029 5.3291 4.746 5.3291 6.22098C5.3291 7.69595 6.52481 8.89166 7.99978 8.89166Z" stroke="#404040" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_3" d="M13.3977 13.2027C12.8294 10.7469 10.6286 8.91357 8.00013 8.91357C5.37162 8.91357 3.17081 10.7449 2.60254 13.2007" stroke="#404040" stroke-linecap="round" stroke-linejoin="round" /> </g> <defs> <clipPath id="clip0_175_4361"> <rect width="16" height="16" fill="white" /> </clipPath> </defs> </svg>
                                              포지션명 : ${item.positionName}
                                            </div>
                                            <!-- <div class="info-item expert-field icon-cash">
                                              <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg"> <g id="Icon_w" clip-path="url(#clip0_113_3379)"> <path id="Vector" d="M20.0883 10.5884C20.0883 15.8351 15.835 20.0884 10.5883 20.0884C5.34155 20.0884 1.08826 15.8351 1.08826 10.5884C1.08826 5.34167 5.34155 1.08838 10.5883 1.08838C15.835 1.08838 20.0883 5.34167 20.0883 10.5884Z" stroke="#404040" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_2" d="M5 11H7" stroke="#404040" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_3" d="M15 11H17" stroke="#404040" stroke-linecap="round" stroke-linejoin="round" /> <path id="w" d="M10.9958 9.06348L9.40985 14.7646H8.35028L6.38837 7.80566H7.42059L8.89032 13.5137L10.4284 7.80566H11.5632L13.0602 13.5137L14.5847 7.80566H15.61L13.6481 14.7646H12.5817L10.9958 9.06348Z" fill="#404040" /> </g> <defs> <clipPath id="clip0_113_3379"> <rect width="21" height="21" fill="white" /> </clipPath> </defs> </svg>
                                              합격축하금 500,000원
                                            </div> -->
                                            <div class="info-item expert-field">
                                              <svg width="16" height="18" viewBox="0 0 16 18" fill="none" xmlns="http://www.w3.org/2000/svg"> <g id="Icon_and_text" clip-path="url(#clip0_454_1281)"> <path id="Vector" d="M7.99989 7.86661C3.87616 7.86661 0.533218 6.43393 0.533218 4.66661C0.533218 2.8993 3.87616 1.46661 7.99989 1.46661C12.1236 1.46661 15.4666 2.8993 15.4666 4.66661C15.4666 6.43393 12.1236 7.86661 7.99989 7.86661Z" stroke="#707070" stroke-width="1.06667" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_2" d="M0.533219 4.66663C0.533219 6.43329 3.87589 7.86663 7.99989 7.86663C12.1239 7.86663 15.4666 6.43329 15.4666 4.66663" stroke="#707070" stroke-width="1.06667" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_3" d="M0.533219 4.66663C0.533219 6.43329 3.87589 7.86663 7.99989 7.86663C12.1239 7.86663 15.4666 6.43329 15.4666 4.66663" stroke="#707070" stroke-width="1.06667" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_4" d="M0.533219 7.86664C0.533219 9.6333 3.87589 11.0666 7.99989 11.0666C12.1239 11.0666 15.4666 9.6333 15.4666 7.86664" stroke="#707070" stroke-width="1.06667" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_5" d="M0.533219 11.0666C0.533219 12.8333 3.87589 14.2666 7.99989 14.2666C12.1239 14.2666 15.4666 12.8333 15.4666 11.0666" stroke="#707070" stroke-width="1.06667" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_6" d="M0.533219 14.2666C0.533219 16.0333 3.87589 17.4666 7.99989 17.4666C12.1239 17.4666 15.4666 16.0333 15.4666 14.2666" stroke="#707070" stroke-width="1.06667" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_7" d="M0.533447 14.2666V4.66663" stroke="#707070" stroke-width="1.06667" stroke-linecap="round" stroke-linejoin="round" /> <path id="Vector_8" d="M15.4666 5.19995V14.8" stroke="#707070" stroke-width="1.06667" stroke-linecap="round" stroke-linejoin="round" /> </g> <defs> <clipPath id="clip0_454_1281"> <rect width="16" height="17.0667" fill="white" transform="matrix(-1 0 0 1 16 0.93335)" /> </clipPath> </defs> </svg>
                                              추천인 보상제도 진행
                                            </div>
                                          </div>
                                        </a>
                                      </div>
                                    </div>
                                    <!-- //posts-foot -->
								</div>
							</div>
						</div>
					</li>
					`;
                        });

                    const recruitPostsUlDiv = document.querySelector('#recruitPostsDiv > ul');
                    document.querySelector('#recruitPostsDiv > .no-data').style.display = 'none';
                    recruitPostsUlDiv.style.display = 'block';
                    document.querySelector('#recruitPostsDiv > .more-data').style.display = 'block';

                    if (initFlag) {
                        recruitPostsUlDiv.innerHTML = html;
                    } else {
                        recruitPostsUlDiv.insertAdjacentHTML('beforeend', html);
                    }

                }
                // 더보기 버튼 제어
                document.querySelector('#recruitPostsDiv > .more-data').style.display = result.recruitListCnt > recruitPageNo * 20 ? 'block' : 'none';
                if (result.recruitListCnt > recruitPageNo * 20) {
                    document.querySelector('#recruitPageNo').textContent = recruitPageNo;
                    document.querySelector('#recruitTotPageNo').textContent = result.pageTotal;
                }

                // 검색된 개수
                document.querySelector('#recruitTitleDiv span.num').textContent = result.recruitListCnt;
            })
            .catch(() => { // error 처리
                document.querySelector('#recruitTitleDiv span.num').textContent = '0';
                const recruitPostsDiv = document.querySelector('#recruitPostsDiv > .no-data');
                recruitPostsDiv.style.display = 'block';
                document.querySelector('#recruitPostsDiv > ul').style.display = 'none';
                document.querySelector('#recruitPostsDiv > .more-data').style.display = 'none';
                recruitPostsDiv.innerHTML = lf_listError();
            }).finally(() => { // 최종
            gf_hideSearchSpinner();
            lf_urlSetting(searchType);
            if (historyBackFlag === true && window.performance.getEntriesByType('navigation')[0].type === 'back_forward') { // 뒤로가기 감지
                for (let i = 1; i < sessionStorage.getItem('recruitPageNo'); i++) {
                    recruitPageNo = i + 1;
                    lf_recruitSearchList(false);
                }
                window.scrollTo(0, sessionStorage.getItem('searchPageScrollY'));
                historyBackFlag = false;
            }
        });
    };

    function lf_selectRecruitStatus(ele, type) {
        $("#recruitStatus ul li").removeClass('active');
        recruitFrontStatusCode = type;
        recruitPageNo = 1;
        $(ele).parent().addClass('active');
        lf_recruitSearchList(true);
    }

    //인재추천 공고 더보기
    function lf_recruitMore() {
        let pageNum = parseInt($("#recruitPageNo").text());
        const totPageNo = parseInt($("#recruitTotPageNo").text());
        pageNum++;

        if (pageNum <= totPageNo) {
            sessionStorage.recruitPageNo = pageNum;
            $("#recruitPageNo").text(pageNum);
            recruitPageNo = pageNum;
            lf_recruitSearchList(false);
        }
    }

    /** 인재추천 공고 상태 선택 모바일 */
    const lf_selectRecruitStatusMobile = (statusCode, initFlag) => {
        const $statusOptionTabActive = document.querySelector('#recruitStatusMobileUl .active');
        const $statusOptionTabLi = document.querySelectorAll('#recruitStatusMobileUl li');
        let statusOptionArr = Array.prototype.slice.call($statusOptionTabLi);

        if (!initFlag) searchParam.recruitFrontStatusCode = statusCode;
        $statusOptionTabActive.classList.remove('active');
        recruitFrontStatusCode = statusCode;

        const findActive = statusOptionArr.filter((item) => {
            return item.dataset.code == statusCode;
        });
        findActive[0].className = 'active';
    }

    /** 인재추천 공고 상태 선택 초기화 모바일 */
    const lf_recruitStatusResetMobile = () => {
        const $statusOptionTabActive = document.querySelector('#recruitStatusMobileUl .active');
        const $statusOptionTabLi = document.querySelectorAll('#recruitStatusMobileUl li');
        let statusOptionArr = Array.prototype.slice.call($statusOptionTabLi);

        searchParam.recruitFrontStatusCode = '';
        $statusOptionTabActive.classList.remove('active');

        const findActive = statusOptionArr.filter((item) => {
            return item.dataset.code == '';
        });
        findActive[0].className = 'active';
    }

    /** 인재추천 공고 상태 최종 선택 버튼 모바일 */
    const lf_confirmRecruitStatusMobile = (initFlag) => {
        const selectStatusName = document.querySelector('#recruitStatusMobileUl .active').textContent;
        document.querySelector('#recruitStatusMobile > span').textContent = selectStatusName;
        document.querySelector('#recruitStatusMobile > a').classList.remove('active');
        document.querySelector('#recruitStatusMobile > a').textContent = '변경';

        // lf_sessionStorageReset();
        if (initFlag) {
            $('#categoryPopupRecruit button.close').click();
            lf_recruitSearchList(true);
        }
    };

    // 세미나 카테고리 선택
    function lf_selectSeminarStatus(ele, type) {
        $("#seminarStatus ul li").removeClass('active');
        seminarStatusCode = type;
        seminarPageNo = 1;
        $(ele).parent().addClass('active');
        lf_seminarSearchList(true);
    }

    function lf_selectSeminarStatusMO(ele, type) {
        $("#categoryPopupSeminar ul li").removeClass('active');
        seminarStatusCode = type;
        seminarPageNo = 1;
        $(ele).parent().addClass('active');
    }
    function lf_confirmSeminarStatusMobile(initFlag) {
        const selectStatusName = document.querySelector('#seminarStatusMobileUl .active').textContent;
        document.querySelector('#seminarStatusMobile > span').textContent = selectStatusName;
        document.querySelector('#seminarStatusMobile > a').classList.remove('active');
        document.querySelector('#seminarStatusMobile > a').textContent = '변경';

        if (initFlag) {
            $('#categoryPopupSeminar button.close').click();
            lf_seminarSearchList(true);
        }
    }

    //인재추천 공고 더보기
    function lf_seminarMore() {
        let pageNum = parseInt($("#seminarPageNo").text());
        const totPageNo = parseInt($("#seminarTotPageNo").text());
        pageNum++;

        if (pageNum <= totPageNo) {
            sessionStorage.seminarPageNo = pageNum;
            $("#seminarPageNo").text(pageNum);
            seminarPageNo = pageNum;
            lf_seminarSearchList(false);
        }
    }

    // 세미나 검색
    function lf_seminarSearchList(initFlag) {
        gf_showSearchSpinner();
        if (initFlag) seminarPageNo = 1;

        // 결과 내 재검색
        detailSearchVal = "";
        $(".piece").each(function (i, v) {
            detailSearchVal += $(v).text() + " ";
        });
        detailSearchVal = detailSearchVal.trim();

        searchParam = {
            pageNo: seminarPageNo,
            searchValue: searchVal,
            serviceType: serviceType,
            initFlag: initFlag,
            keywordFilter: '',
            keywordDetail: detailSearchVal,
            startPage: (seminarPageNo - 1) * 20,
            seminarStatusCode: seminarStatusCode,
            endPage: 20,
        };

        const data = {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(searchParam),
        };
        lf_getData('/common/ajax/seminarSearchListAjax', data)
            .then((result) => {
                if (result.seminarListCnt < 1) {
                    const seminarPostsDiv = document.querySelector('#seminarPostsDiv > .no-data');
                    seminarPostsDiv.style.display = 'block';
                    document.querySelector('#seminarPostsDiv > ul').style.display = 'none';
                    document.querySelector('#seminarPostsDiv > .more-data').style.display = 'none';
                    seminarPostsDiv.innerHTML = lf_noData();
                } else {
                    let html = '';
                    // 인재추천 공고 상태에 따른 class 객체
                    const statusCodeName = {
                        'SEM_ST_001': {
                            className: '',
                            name: '모집중'
                        },
                        'SEM_ST_002': {
                            className: '',
                            name: '종료',
                        },
                        'SEM_ST_003': {
                            className: 'review-v6',
                            name: '후기',
                        },
                    };
                    [...result.seminarList]
                        .map((item) => {
                            html += `
                            <li class="posts-item">
                                <div class="posts-rows posts-rows-v6">
                                    <div class="posts-cols posts-data">
                                        <div class="posts-main">
                                            <div class="posts-head">
                                                <div class="posts-sort ${item.seminarStatusCode === 'SEM_ST_002' ? 'completed' : ''}">
                                                    <span class="badge badge-lg badge-client badge-review-v6 ${statusCodeName[item.seminarStatusCode].className}">${item.seminarStatusCodeName }</span>
                                                    <span class="date">${item.recruitmentStartDate } ~ ${item.recruitmentEndDate }</span>
                                                </div>
                                                <div class="posts-name">
                                                    <a href="seminar.html?seminarSeq=${item.seminarSeq }" class="text">${item.title }</a>
                                                </div>
                                            </div>
                                            <div class="posts-foot">
                                                <div class="posts-info">
                                                    <a href="#" class="link-wrap">
                                                        <div class="info-area">
                                                            <div class="review-info-item-v6 expert-field">
                                                                <label>
                                                                      <span class="icon-v6">
                                                                          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <g clip-path="url(#clip0_6_7302)">
                                                                              <path d="M14.0688 2.39711C18.2675 4.64377 19.8501 9.86884 17.6034 14.0676C15.3567 18.2664 10.1317 19.8489 5.93289 17.6023C1.7341 15.3556 0.151583 10.1306 2.39824 5.93176C4.6449 1.73297 9.86996 0.150456 14.0688 2.39711Z" stroke="#404040" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                                                              <path d="M10 5V10.5L13.5 13" stroke="#404040" stroke-width="1.5" />
                                                                            </g>
                                                                            <defs>
                                                                              <clipPath id="clip0_6_7302">
                                                                                <rect width="20" height="20" fill="white" />
                                                                              </clipPath>
                                                                            </defs>
                                                                          </svg>
                                                                      </span>
                                                                </label>
                                                                <span class="detail-text-v6-1">
                                                                      일시: ${item.seminarDateStr }
                                                                  </span>
                                                            </div>
                                                            <div class="review-info-item-v6 expert-field review-info-item-second-v6">
                                                                <label>
                                                                      <span class="icon-v6">
                                                                          <svg width="16" height="20" viewBox="0 0 16 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <g clip-path="url(#clip0_6_7755)">
                                                                              <path d="M7.85713 4.28564C5.88571 4.28564 4.28571 5.88564 4.28571 7.85707C4.28571 9.8285 5.88571 11.4285 7.85713 11.4285C9.82856 11.4285 11.4286 9.8285 11.4286 7.85707C11.4286 6.90707 11.05 5.99993 10.3857 5.3285C9.71428 4.65707 8.80713 4.28564 7.85713 4.28564ZM7.85713 9.99993C6.67142 9.99993 5.71428 9.04279 5.71428 7.85707C5.71428 6.67136 6.67142 5.71422 7.85713 5.71422C9.04285 5.71422 9.99999 6.67136 9.99999 7.85707C9.99999 9.04279 9.04285 9.99993 7.85713 9.99993Z" fill="#404040" />
                                                                              <path d="M7.85714 0C3.52143 0 0 3.52143 0 7.85714C0 10.6643 1.29286 13.6357 3.75 16.45C4.85 17.7214 6.09286 18.8714 7.45 19.8714C7.69286 20.0429 8.02143 20.0429 8.27143 19.8714C9.62857 18.8714 10.8643 17.7286 11.9643 16.45C14.4143 13.6286 15.7143 10.6571 15.7143 7.85714C15.7071 3.52143 12.1929 0 7.85714 0ZM7.85714 18.3929C6.37857 17.2286 1.42857 12.9714 1.42857 7.85714C1.42857 4.30714 4.30714 1.42857 7.85714 1.42857C11.4071 1.42857 14.2857 4.30714 14.2857 7.85714C14.2857 12.9643 9.33571 17.2286 7.85714 18.3929Z" fill="#404040" />
                                                                            </g>
                                                                            <defs>
                                                                              <clipPath id="clip0_6_7755">
                                                                                <rect width="15.7143" height="20" fill="white" />
                                                                              </clipPath>
                                                                            </defs>
                                                                          </svg>
                                                                      </span>
                                                                </label>
                                                                <span class="detail-text-v6-2">
                                                                      장소: ${item.location }
                                                                  </span>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
					`;
                        });

                    const seminarPostsUlDiv = document.querySelector('#seminarPostsDiv > ul');
                    document.querySelector('#seminarPostsDiv > .no-data').style.display = 'none';
                    seminarPostsUlDiv.style.display = 'block';
                    document.querySelector('#seminarPostsDiv > .more-data').style.display = 'block';

                    if (initFlag) {
                        seminarPostsUlDiv.innerHTML = html;
                    } else {
                        seminarPostsUlDiv.insertAdjacentHTML('beforeend', html);
                    }

                }
                // 더보기 버튼 제어
                document.querySelector('#seminarPostsDiv > .more-data').style.display = result.seminarListCnt > seminarPageNo * 20 ? 'block' : 'none';
                if (result.seminarListCnt > seminarPageNo * 20) {
                    document.querySelector('#seminarseminarPageNo').textContent = seminarPageNo;
                    document.querySelector('#seminarTotPageNo').textContent = result.pageTotal;
                }

                // 검색된 개수
                document.querySelector('#seminarTitleDiv span.num').textContent = result.seminarListCnt;
            })
            .catch(() => { // error 처리
                document.querySelector('#seminarTitleDiv span.num').textContent = '0';
                const seminarPostsDiv = document.querySelector('#seminarPostsDiv > .no-data');
                seminarPostsDiv.style.display = 'block';
                document.querySelector('#seminarPostsDiv > ul').style.display = 'none';
                document.querySelector('#seminarPostsDiv > .more-data').style.display = 'none';
                seminarPostsDiv.innerHTML = lf_listError();
            }).finally(() => { // 최종
            gf_hideSearchSpinner();
            lf_urlSetting(searchType);
            if (historyBackFlag === true && window.performance.getEntriesByType('navigation')[0].type === 'back_forward') { // 뒤로가기 감지
                for (let i = 1; i < sessionStorage.getItem('seminarPageNo'); i++) {
                    seminarPageNo = i + 1;
                    lf_seminarSearchList(false);
                }
                window.scrollTo(0, sessionStorage.getItem('searchPageScrollY'));
                historyBackFlag = false;
            }
        });
    };

    //PC 프로젝트 상태별 조회
    function lf_selectProjectStatus(ele, type){
        $("#statusUL").children('li').removeClass('active');
        statusType = type;
        projectPageNo = 1;
        $(ele).addClass('active');
        lf_projectSearchList(true);
    }

    //모바일 프로젝트 상태별 조회
    function lf_selectProjectStatus_M(ele, type){
        $(ele).siblings('li').removeClass("active");
        statusType = type;
        if(type == 'recruit'){
            statusTypeNm = '지원중';
        } else if(type == 'complete'){
            statusTypeNm = '모집완료';
        } else {
            statusTypeNm = '전체';
        }

        $(ele).addClass('active');
    }

    //모바일 프로젝트 상태조회 선택
    function  lf_projectStatusList(){
        $("#prjCategoryTxt").text(statusTypeNm);

        projectPageNo = 1;
        lf_projectSearchList(true);
        $("body").removeClass("active-category-popup-project");
    }

    //더보기 (페이지 번호를 올려서 검색)
    function lf_moreProjectList() {
        var pageNum = parseInt($("#projectPageNo").text());
        var totPageNo = parseInt($("#projectTotPageNo").text());
        pageNum++;

        if(pageNum <= totPageNo) {
            sessionStorage.projectPageNo = pageNum;
            $("#projectPageNo").text(pageNum);
            projectPageNo = pageNum;
            lf_projectSearchList(false);
        }
    }


    $(document).on("click", "input[name='expertScrap']", function () {

        if('N' == 'Y') {
            if('' == 'SVC_TY002') {
                var expertSeq = $(this).attr("id").replace("expertScrap", "");
                var chked = $(this).is(":checked") ? "Y" : "N";

                lf_expertScrapFnc(chked, expertSeq);
            } else {

                if($(this).parent().find('input[type="checkbox"]').is(':checked')){
                    $(this).parent().find('input[type="checkbox"]').prop("checked", false);
                }

                gf_openToastDefault("Client만 이용 가능한 서비스에요.");
            }
        } else {

            if($(this).parent().find('input[type="checkbox"]').is(':checked')){
                $(this).parent().find('input[type="checkbox"]').prop("checked", false);
            }

            gf_forClientNotice();
        }

    });

    function lf_expertScrapFnc(isScrap, scrapExpertSeq) {
        $.ajax({
            url : "/common/ajax/expertScrapAjax"
            ,method : "POST"
            ,data : {
                isScrap : isScrap
                ,scrapExpertSeq : scrapExpertSeq
            }
            ,dataType : "json"
            ,success : function(data) {
                if(isScrap == 'Y') {
                    gf_openToast(1, "전문가님이 스크랩되었습니다.")
                } else {
                    gf_openToastDefault("스크랩이 해제되었습니다.");
                }
            }
        });
    }

    //자문 요청
    function lf_requiredCounsel(userSeq, counselType){

        if('N' == 'Y') {
            if('' == 'SVC_TY002') {
                location.href = "expert.html?userSeq="+userSeq+"&counselType=" + counselType;
            } else {
                gf_openToastDefault("Client만 이용 가능한 서비스에요.");
            }
        } else {
            gf_forClientNotice();
        }

    }
</script>
