	// 새로운 알림이 있는지 검사...
	var newAlarm = false;
	$.ajax({
		url : "/common/ajax/selectNewAlarmCnt"
		,data : {}
		,dataType : "json"
		,contentType: "application/json"
		,cache : false
		,success : function(data) {
			if(data.result_code == "SUCCESS" && data.resultValue01 == "Y") {
				$("#msgNewDiv").css("display", "block");
				$("#messageManage").addClass("active update");
				newAlarm = true;
			}else{
				$("#msgNewDiv").css("display", "none");
				$("#messageManage").removeClass("active update");
			}
		}
	});

	$("#accountArea").click(function() {
		if($(".client-side-login").hasClass("active")){
			$("#msgNewDiv").css("display", "none");
		}
	});

	$(document).mouseup(function (e) {
		if(newAlarm){
			var container = $("#msgNewDiv");
			if (container.has(e.target).length == 0) {
				if(!false){
					container.show();
				}
			}
		}
	});

	function lf_solutionCntChk(){
		var solutionCnt = "";
		if(solutionCnt < 5){
			location.href = "/expert/profile/solutionRegForm";
		} else {
			gf_openToastDefault("Expert's 제안은 최대 5개까지 등록 가능해요.");
		}
	}

	function lf_newNonMemberSearchSession(seq) {
		var chk = true;

		// 누락항목 체크
		$(".empty").each(function(i, v) {
			$(this).removeClass("empty");
		});

		var email = $("#firstEmail" + seq).val()+"@"+$("#lastEmail" + seq).val();
		if (!gf_emailChk(email)) {
			$(".mail-input-box").addClass("empty");
			$(".empty-txt").show();

			chk = false;
		}

		var agreeChk = $("#terms5" + seq).is(":checked");
		if (!agreeChk) {
			gf_openToastDefault("개인정보 이용에 동의해주세요.");
			chk = false;
		}

		if(chk){
			// 저장 ajax
			var email = $("#firstEmail" + seq).val()+"@"+$("#lastEmail" + seq).val();
			$("#email" + seq).val(email);

			var nonMemberParam = {
				userSearchedSeq : 0
				,firstJobFieldCode : $("#firstJobFieldCode" + seq).val()
				,secondJobFieldCode : $("#secondJobFieldCode" + seq).val()
				,servicePaymentHourPriceCode : $("#servicePaymentHourPriceCode" + seq).val()
				,servicePaymentDayPriceCode : $("#servicePaymentDayPriceCode" + seq).val()
				,searchTag : $("#searchTag" + seq).val()
				,searchValue : $("#searchValue" + seq).val()
				,email : $("#email" + seq).val()
			};

			$.ajax({
				 url : "/common/ajax/insertNewExpertAlarm"
				,method : "POST"
				,data : nonMemberParam
				,dataType : "json"
				,success : function(data) {
					if(data.result_code == 'SUCCESS') {
						gf_openToastDefault("New 전문가 소식받기가 완료되었어요!");

						// 검색 히스토리 쿠키 삭제(유효기간을 바로 만료시킴)
						//document.cookie = seq + '=' + escape("-1");
						setCookie(seq,'','-1');
					} else if(data.result_code == 'FAIL') {
						gf_checkPopup("동일한 신청 내역이 있어요", "해당 검색 조건으로 이미 알람을 신청하셨습니다. ", "", "확인", "sorry");
						$("#popBtn2").off().on('click', gf_confirmPopClose);
					}

					$("#nonUserNewExpertAlarm" + seq).hide();
				}
			});
		}
	}

	//자동완성 밖 클릭시 드롭다운 none
	$("body").click(function() {
		$("#autoSearchExpert").css("display", "none");
	});

///////////////////////////////////////////
	var isApp = false;
	function lf_goView(alarmSeq, linkUrl, alarmType) {
		$.ajax({
			url : "/notice/ajax/updateAlarmViewDate"
			,data : {
				alarmSeq : alarmSeq
				,alarmType : alarmType
			}
			,dataType : "json"
			,contentType: "application/json"
			,cache : false
			,success : function(data) {
				if(linkUrl != "") {
					// App Badge 카운트 수정함
					if (isApp) {
						lf_readMsg(alarmSeq, 0);
					}
					location.href = linkUrl;
				} else {
					location.reload(true);
				}
			}
		});
	}

	function lf_readAllAlarm() {
		$.ajax({
			url : "/notice/ajax/updateViewAllAlarm"
			,dataType : "json"
			,contentType: "application/json"
			,cache : false
			,success : function() {
				$(".notice-list-wrap li").addClass("read");
				$(".num").css('display', 'none');
			}
		});
	}
