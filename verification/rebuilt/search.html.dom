    //faq 카테고리별 보기
    let depth ="";
    function lf_categoryList(deptNum) {
        depth = deptNum;
        if(deptNum == ''){
            lf_viewControl('SEARCH_TY008');
        }else{
            $.ajax({
                url : "/common/ajax/faqCatagoryListAjax"
                ,data : {
                    depth : deptNum
                }
                ,dataType : "json"
                ,contentType: "application/json"
                ,success : function(data) {
                    $("#faqUserTypeLI").html("");
                    let html = "";
                    let cataCode = ""
                    for (var i=0; i<data.length; i++){
                        cataCode = data[i].faqCategoryCode;
                        if(i == 0){
                            html +=  "<li class='tab-item active' data-field='"+ data[i].faqCategoryCode +"'><a href='javascript:void(0);' onclick='lf_faqSearchList(true,\""+cataCode +"\")'>" + data[i].faqCategoryCodeName +"</a></li>";
                        }else{
                            html +=  "<li class='tab-item' data-field='"+ data[i].faqCategoryCode +"'><a href='javascript:void(0);' onclick='lf_faqSearchList(true,\""+cataCode +"\")'>" + data[i].faqCategoryCodeName +"</a></li>";
                        }
                    }

                    $("#faqUserTypeLabel").css("display", "none");
                    $("#faqUserTypeLI").css("display", "flex");
                    $("#faqUserTypeLI").append(html);
                    $('#faqUserTypeLI .tab-item').click(function() {
                        $('#faqUserTypeLI .tab-item').removeClass('active');
                        $(this).addClass('active');
                    });

                    lf_faqSearchList(true, "");

                }
                ,error : function(data) {
                }
            });
        }
    }

