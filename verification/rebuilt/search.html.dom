    // faq 검색
    function lf_faqSearchList(initFlag, faqCategoryCode) {
        gf_showSearchSpinner();
        if(initFlag) faqPageNo = 1;
        var serviceType = '';

        // 결과 내 재검색
        detailSearchVal = "";
        $(".piece").each(function(i, v){
            detailSearchVal += $(v).text() + " ";
        });
        detailSearchVal = detailSearchVal.trim();

        searchParam = {
            sortType 								: ''
            ,pageNo  								: faqPageNo
            ,serviceType 							: serviceType
            ,depth									: depth
            ,faqCategoryCode						: faqCategoryCode
            ,firstJobFieldCode  					: ''
            ,secondJobFieldCode 					: ''
            ,servicePaymentHourPriceCode 			: ''
            ,servicePaymentDayPriceCode  			: ''
            ,searchTag   							: ''
            ,searchValue 							: searchVal
            ,initFlag    							: initFlag
            ,keywordFilter							: ''
            ,keywordDetail							: detailSearchVal
            ,sortColumn								: ''
            ,sortDirection							: ''
        };

        // faq 검색(+ 건수)
        $.ajax({
            url : "/common/ajax/faqSearchListAjax"
            ,type : "POST"
            ,data : searchParam
            ,dataType : "html"
            ,beforeSend : function() {
                if(faqPageNo == 1){
                    $("#faqSearchLI").html("");
                }
            }
            ,success : function(data) {
                if(!data.match('class="local-name">SYSTEM ERROR')) {
                    let jObj = JSON.parse(data);
                    let html = "";
                    let faqTotalCount = jObj.faqListCnt;
                    $("#faqErrResultDiv").hide();

                    if(faqTotalCount == 0){
                        $("#faqNum").text('0');
                        $("#faqNoResultDiv").show();
                        $("#faqSearchLI").hide();
                        //$("#faqSearchDiv").append(html);
                    }else{
                        $("#faqNum").text(faqTotalCount);
                        for (let item of jObj.faqList) {
                            html += `
					<li>
						<h4>
							<a href="#">
								<span class="badge badge-edge badge-lg">${item.faqCategoryCodeName}</span>
								<span class="text">${item.title}</span>
							</a>
						</h4>
						<div class="faq-list-content">${item.content}</div>
					</li>
					`;
                        }
                        $("#faqTotPageNo").text(jObj.pageTotal);
                        $("#faqNoResultDiv").hide();
                        $("#faqSearchLI").show();
                        $("#faqSearchLI").append(html);
                        lf_expandFaqDetail();
                    }
                    faqTotalCount < 21 ? $('#faqSearchPage').hide() : $('#faqSearchPage').show();
                }else{
                    $("#faqNum").text('0');
                    $("#faqErrResultDiv").show();
                    $("#faqNoResultDiv").hide();
                    $("#faqSearchLI").hide();
                }
                gf_hideSearchSpinner();
            }
            ,error : function() {
                $("#faqNum").text('0');
                $("#faqErrResultDiv").show();
                $("#faqNoResultDiv").hide();
                $("#faqSearchLI").hide();
                gf_hideSearchSpinner();
            }
        });

        //history replace
        lf_urlSetting(searchType);
    }

