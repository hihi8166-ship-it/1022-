    //모바일 전문분야 재검색 List Set
    function lf_selectJobField_M(parentFieldNm, parentFieldCd, ele, param) {
        if(ele != ''){
            //상세분야 list 선택시
            expertPageNo = 1;
            $(ele).parent().siblings('li').removeClass("active");
            $(ele).parent().addClass("active"); // 선택값만 active
        } else {
            //상세분야 파라미터로 넘어왔을 경우
            const fieldLI = document.querySelectorAll("[data-jobfield]");
            fieldLI.forEach((e, i) => {
                $(e).removeClass("active");
                if($(e).data("jobfield") == parentFieldCd){
                    $(e).addClass("active");
                    parentFieldNm = $(e).children().text();
                }
            });
        }

        //전문분야 선택이 들어갔을때
        $.ajax({
            url : "/common/ajax/getJobField2List?parentJobFieldCode="+parentFieldCd
            ,method : "get"
            ,dataType : "json"
            ,contentType: "application/json"
            ,cache : false
            ,success : function(data) {
                var str = "";
                $(data).each(function(i, v) {
                    if(param != ''){
                        //검색된 전문분야코드가 존재할때 해당분야 자동검색
                        if(v.jobFieldCode == param){
                            str += "<li class='active'><a href='javascript:void(0)' onclick='lf_selectDetailJobField_M(\"" + v.jobFieldCode + "\",\"상세분야 전체 선택\" ,this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
                            firstJobFieldNm = parentFieldNm;
                            secondJobFieldNm = v.jobFieldNm;
                            secondJobFieldCode = v.jobFieldCode;
                            $("#categoryTxt").text(firstJobFieldNm + " > " + secondJobFieldNm);
                            $("#categoryBtn").text("변경");
                            lf_viewControl($('.tab-item.active').data('field'));
                        } else {
                            str += "<li><a href='javascript:void(0)' onclick='lf_selectDetailJobField_M(\"" + v.jobFieldCode + "\",\"" + v.jobFieldNm + "\" ,this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
                        }
                    } else {
                        if (i == 0) {
                            str += "<li class='active'><a href='javascript:void(0)' onclick='lf_selectDetailJobField_M(\"" + v.jobFieldCode + "\",\"상세분야 전체 선택\" ,this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
                            firstJobFieldNm = parentFieldNm;
                            secondJobFieldNm = "상세분야 전체 선택";
                            secondJobFieldCode = v.jobFieldCode;
                        } else {
                            str += "<li><a href='javascript:void(0)' onclick='lf_selectDetailJobField_M(\"" + v.jobFieldCode + "\",\"" + v.jobFieldNm + "\" ,this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
                        }
                    }
                });
                $('[id^="detailFieldUL_mo"]').html(str);

                if(parentFieldCd == ''){
                    secondJobFieldCode = '';
                    firstJobFieldNm = '';
                    secondJobFieldNm = '';
                }

                //통합검색 전문분야 선택 스크롤 mobile
                var MchkList = $(".category-popup .check-list").eq(0).find(".scroll");
                var MactiveIdx = MchkList.find("li.active").index();
                var MFieldHeight =  MchkList.find("li").height();
                MchkList.animate({scrollTop: MactiveIdx * MFieldHeight }, 1000);
            }
            ,error : function(data) {
                gf_checkPopup("오류가 발생했어요","잠시 후 다시 이용해주세요.<br>계속해서 오류가 발생하면<br>고객센터(tbhelp@talentbank.co.kr)로 연락해주세요.","","확인", "sorry");
                $("#popBtn2").off().on('click', gf_confirmPopClose);
            }
        });
    }

