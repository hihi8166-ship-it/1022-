	//안드로이드 배너 클릭시 앱링크 이동
	function lf_appLink() {
		var requestURL = 'http://www.talentbank.co.krsearch.html?searchValue=IPO';
		setTimeout(function() {
			location.href = "intent://openurl?randingUrl=" + requestURL + "#Intent;scheme=talentbank;package=kr.co.hunet.talentbank;end";
		}, 1000);
