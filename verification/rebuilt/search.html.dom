<script type="text/javascript">
var openOpt = { backdrop:true, backdropClick:true, keyboard:true, positionFixed:true };

// 경고 열기
$('#alertOpen').on('click',function() {
	$('#alertPop').popup(openOpt);
});
// 확인
$('#confirmOpen').on('click',function() {
	$('#confirmPop').popup(openOpt);
});
$('#alertBtn').on('click',function() {
	$('#alertPop').popup({ show : false });
});
$('#confirmBtn1').on('click',function() {
	$('#confirmPop').popup({ show : false });
});
$('#confirmUpBtn1').on('click',function() {
	$('#confirmPopup').popup({ show : false });
});

//new 팝업 확인할때..
$('#popBtn1').on('click',function() {
	$('#checkPopup').popup({ show : false });
});
$('#popBtn2').on('click',function() {
	$('#checkPopup').popup({ show : false });
});

//경고 다이얼로그 오픈
function gf_alertOpen(content) {
	$("#alertContent").html(content);
	$('#alertPop').popup(openOpt);
	$(".popup-backdrop").css("z-index", "999");
}

// 확인 다이얼로그 오픈
function gf_confirmOpen(content, btnName) {
	$("#confirmContent").html(content);
	if(btnName != undefined && btnName != "")
		$("#confirmBtn2").html(btnName);
	$('#confirmPop').popup(openOpt);
	$(".popup-backdrop").css("z-index", "999");
}

// 경고 다이얼로그 오픈
function gf_alertPop(content, icon) {
	$("#alertContent").html(content);
	$('#alertPop').popup(openOpt);
	lf_popIconSet(icon, "alertPopBackdrop");
}

// 확인 다이얼로그 오픈
function gf_confirmPop(content, btnName, icon) {
	$("#confirmContent").html(content);
	if(btnName != undefined && btnName != "")
		$("#confirmBtn2").html(btnName);
	$('#confirmPop').popup(openOpt);
	lf_popIconSet(icon, "confirmPopBackdrop");
}

//확인 다이얼로그 오픈 (버튼3개)
function gf_confirmPopup(content, btnName, btnName2, icon) {
	$("#confirmUpContent").html(content);
	if(btnName != undefined && btnName != "")
		$("#confirmUpBtn2").html(btnName);
	if(btnName2 != undefined && btnName2 != "")
		$("#confirmUpBtn3").html(btnName2);
	$('#confirmPopup').popup(openOpt);
	lf_popIconSet(icon, "confirmPopupBackdrop");
}

// 다이얼로그 아이콘 set
function lf_popIconSet(icon, backdropId) {
	if(icon == "notice") {
		$(".popicon").removeClass().addClass("icon popicon icon-alert-exclamation");
	} else if(icon == "info") {
		$(".popicon").removeClass().addClass("icon popicon icon-alert-info");
	} else if(icon == "confirm") {
		$(".popicon").removeClass().addClass("icon popicon icon-alert-check");
	} else if(icon == "question") {
		$(".popicon").removeClass().addClass("icon popicon icon-alert-question");
	} else if(icon == "sorry") {
		$(".popicon").removeClass().addClass("icon popicon icon-alert-caution");
	}
	$("#" + backdropId).css("z-index", "999"); // backdrop 의 z-index 조정...
}

// 모집기간 팝업
function gf_expertOnly() {
	$('#myPopup1').popup({backdrop:true,backdropClick:true,keyboard:true,positionFixed:true});
}

//다이얼로그 열기
function gf_openPop(eleId) {
	$('#'+eleId).popup({backdrop:true,backdropClick:true,keyboard:true,positionFixed:true});
}

//다이얼로그 닫기
function gf_closePop(eleId) {
	$('#'+eleId).popup({show:false});
	$("#" + eleId + "Backdrop").remove();
	$('body').removeClass('modal-open');
	$('body').removeClass('no-scroll');
	$('body').css('overflow', '');
	$('body').removeClass('active-info-disclosure');
}

/**
 * 다이얼로그 닫기 - 닫고 backdrop 까지 remove
 * @author kjs
 * @date 2019-03-12
 */
function gf_closePop2(eleId) {
	$('#' + eleId).popup({show:false});
	$("#" + eleId + "Backdrop").remove();
}

//로그인 탭 선택
function lf_setServiceType(val) {
	$("#serviceTypeCode").val(val);
}
</script>


