	function lf_searchAuto(keyword, type) {
		var searchValue = "";
		if(type == 'srchValueAuto') {
			searchValue = $("input[name='searchValue']").val();
		} else if(type == 'localSearchKeyword') {
			searchValue = $("#localSearchKeyword-2").val();
		}

		if(searchValue != undefined && searchValue != '') {
			$.ajax({
				url : "/common/ajax/autoKeyword"
				,data : { keyword : keyword }
				,dataType : "json"
				,contentType : "application/json"
				,cache : false
				,success : function(data) {
					var html = "";
					if(data != null && data.length > 0) {
						$(data).each(function(i, v) {
							html += `<button type="button" class="item" onclick="lf_goSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							//html += "<button type=\"button\" class=\"item\" onclick=\"lf_goExpertSearchListPage('" + v.profileTitle + "');\">" + v.highlightProfileTitle + "</button>";
						});

						if(type == 'srchValueAuto') {
							$("#autoSearchExpert").css("display","block");
							$(".main-search-drop").css("display","none");

						} else if(type == 'localSearchKeyword') {
							$("#autoSearchExpertMo").css("display","block");
							$(".main-search-drop").css("display","none");
						}
					} else {
						html = "";
						if(type == 'srchValueAuto') {
							$("#autoSearchExpert").css("display","none");
						} else if(type == 'localSearchKeyword') {
							$("#autoSearchExpertMo").css("display","none");
						}
					}
					if(type == 'srchValueAuto') {
						$("#autoSearchExpert").html(html);
					} else if(type == 'localSearchKeyword') {
						$("#autoSearchExpertMo").html(html);
					}
				}
			});
		} else {
			if(type == 'srchValueAuto') {
				$("#autoSearchExpert").css("display", "none");
				$("#autoSearchExpert").html(""); // (이전 검색 기록에 대한)자동완성 제거
			} else if(type == 'localSearchKeyword') {
				$("#autoSearchExpertMo").css("display", "none");
				$("#autoSearchExpertMo").html(""); // (이전 검색 기록에 대한)자동완성 제거
			}
		}
	}

	function lf_searchExpertAuto(keyword, type) {
		var searchValue = "";
		if(type == 'srchValueAuto') {
			searchValue = $("input[name='searchValue']").val();
		} else if(type == 'localSearchKeyword') {
			searchValue = $("#localSearchKeyword-2").val();
		}
		// 검색 타입(전문가, 상품, 공고, 온자)에 따른 분기 처리
		const searchFilter = $(".local-search-main .main-search-drop a");
		let searchFilterIdx;
		for (var i =0; i<searchFilter.length; i++){
			if (searchFilter[i].className.indexOf("on") > 0){
				searchFilterIdx = i;
			}
		}
		if(searchValue != undefined && searchValue != '') {
			$.ajax({
				url : "/common/ajax/autoKeyword"
				,data : { keyword : keyword }
				,dataType : "json"
				,contentType : "application/json"
				,cache : false
				,success : function(data) {
					var html = "";
					if(data != null && data.length > 0) {
						$(data).each(function(i, v) {
							if (searchFilterIdx == 0) {
								html += `<button type="button" class="item" onclick="lf_goExpertSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							} else if (searchFilterIdx == 1) {
								html += `<button type="button" class="item" onclick="lf_goProjectProductSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							} else if (searchFilterIdx == 2) {
								html += `<button type="button" class="item" onclick="lf_goProjectSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							} else if (searchFilterIdx == 3) {
								html += `<button type="button" class="item" onclick="lf_goConsultSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							}
							//html += "<button type=\"button\" class=\"item\" onclick=\"lf_goExpertSearchListPage('" + v.profileTitle + "');\">" + v.highlightProfileTitle + "</button>";
						});
						if(type == 'srchValueAuto') {
							$("#autoSearchExpert").css("display","block");
							$(".main-search-drop").css("display","none");

						} else if(type == 'localSearchKeyword') {
							$("#autoSearchExpertMo").css("display","block");
							$(".main-search-drop").css("display","none");
						}
					} else {
						html = "";
						if(type == 'srchValueAuto') {
							$("#autoSearchExpert").css("display","none");
						} else if(type == 'localSearchKeyword') {
							$("#autoSearchExpertMo").css("display","none");
						}
					}
					if(type == 'srchValueAuto') {
						$("#autoSearchExpert").html(html);
					} else if(type == 'localSearchKeyword') {
						$("#autoSearchExpertMo").html(html);
					}
				}
			});
		} else {
			if(type == 'srchValueAuto') {
				$("#autoSearchExpert").css("display", "none");
				$("#autoSearchExpert").html(""); // (이전 검색 기록에 대한)자동완성 제거
			} else if(type == 'localSearchKeyword') {
				$("#autoSearchExpertMo").css("display", "none");
				$("#autoSearchExpertMo").html(""); // (이전 검색 기록에 대한)자동완성 제거
			}
		}
	}

	function lf_goSearchListPage(val) {
		sessionStorage.expertScrollTop = 0;
		location.href = "search.html?searchValue=" + encodeURIComponent(val);
	}

	function lf_goExpertSearchListPage(val) {
		sessionStorage.expertScrollTop = 0;
		if ($("#localSearchKeyword").hasClass("client")) {
			location.href = "experts.html?searchValue=" + encodeURIComponent(val);
		}else if ($("#localSearchKeyword").hasClass("expert")) {
			location.href = "/common/project/projectSearch?searchValue=" + encodeURIComponent(val);
		}
	}

	function lf_goProjectSearchListPage(val) {
		location.href = "/common/project/projectSearch?searchValue=" + encodeURIComponent(val);
		sessionStorage.projectSearchScrollTop = 0;
	}

	function lf_goProjectProductSearchListPage(val) {
		location.href = "/common/productSearchList?searchValue=" + encodeURIComponent(val);
		sessionStorage.productListScrollY = 0;
	}

	function lf_goConsultSearchListPage(val) {
		location.href = "/common/consult-list?searchValue=" + encodeURIComponent(val);
		sessionStorage.projectSearchScrollTop = 0;
	}


