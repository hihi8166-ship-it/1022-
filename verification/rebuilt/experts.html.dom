						<a href="expert.html?userSeq=24388">
							<!-- posts-head -->
							<div class="posts-head">
								<div class="posts-name">
									<span class="text">건기식 원료/제품/임상/개발</span>
								</div>
								<div class="posts-info">
									<div class="info-area">
										
											<span class="info-item expert-field">
													Other
