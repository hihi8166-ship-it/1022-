<script type="text/javascript">
	$(function() {
		var localNavigations = new Swiper('.local-navi .swiper-container', {
			slidesPerView: "auto",
			freeMode: true,
			grabCursor: true,
			simulateTouch: true,
			preventClicks: true,
			paginationClickable: true,
			autoHeight: true,
			noSwiping: true,
			noSwipingClass : 'lnb-list',
			breakpoints: {
				910: {
					noSwiping: false,
				},
			}
		});

		

		/**
		* Client 상단 Expert 검색창 자동완성
		*/
		if('for-nonmembers' == 'for-client' || 'for-nonmembers' == 'for-nonmembers' || 'for-nonmembers' == 'for-expert') {
			$(".srchValueAuto").autocomplete({
				source : function(request, response) {
					setTimeout(function() {
						lf_searchAuto(request.term, 'srchValueAuto');
						//lf_searchExpertAuto(request.term, 'srchValueAuto');
					}, 1);
				},
				delay: 300,
				minLength: 0,
				focus: function(event, ui) { // 파이어폭스 브라우저에서 한글 검색이 안되는 현상 방지
					event.preventDefault();
					return false;
				}
			});

			$(".localSearchKeyword").autocomplete({
				source : function(request, response) {
					setTimeout(function() {
						lf_searchAuto(request.term, 'localSearchKeyword');
						//lf_searchExpertAuto(request.term, 'localSearchKeyword');
					}, 1);
				},
				delay: 300,
				minLength: 0,
				focus: function(event, ui) { // 파이어폭스 브라우저에서 한글 검색이 안되는 현상 방지
					event.preventDefault();
					return false;
				}
			});
		}

		$('.account-area .avatar-drop-menu').buiToggle({
			reactTarget: 'body',
			reactActiveClass: 'active-account-area',
			clickout: true,
			clickoutTarget: '.account-item',
			closeButtonText: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><title>닫기</title><path d="M23.896,1.586l-10.309,10.4L24,22.301l-1.586,1.6L12.006,13.582L1.679,24l-1.584-1.583l10.317-10.416L0,1.683L1.582,0.1L11.99,10.407L22.296,0.001L23.896,1.586z"/></svg>',
		});
	});

	$(function() {
		/**
		 * Project 상태 가이드 팝업
		 */
		// $('.project-status-guide').modal();
		/**
		 * Project 상태 가이드 팝업
		 */
		// $('.project-status-guide').modal();
		if('common' != 'main') {
			var canDisplayGuide = false;
			/* if('' == 'projectRegType' || '' == 'projectReg1' || '' == 'projectRegForm') { */
			if('false') {
				canDisplayGuide = true;
			} else if('' == 'profileHistory' || '' == 'projectViewContent' || '' == 'projectViewCompany' || '' == 'projectViewQna' || '' == 'projectViewAdmCmt' || '' == 'projectViewContract' || '' == 'projectApplyList' || 'expert-list' == 'solutionView' || '' == 'projectApplyView' || '' == 'projectApply') {
				if(!(('' == 'projectApply' && '' == 'Y') || ('' == 'projectApply' && '' > 0 && '' != 'PRJ_ST014') || ('' == 'projectApply' && '' == 'N') || ('' == 'projectApplyView'))) {
					if('expert-list' != 'solutionView') {
						canDisplayGuide = true;
					}
				}
			}


			if(canDisplayGuide) {
				var projectStatusGuide = $('.direct-project-status-guide').buiToggle({
					close: true,
					closeButtonText: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><title>닫기</title><path d="M12 11.293l10.293-10.293.707.707-10.293 10.293 10.293 10.293-.707.707-10.293-10.293-10.293 10.293-.707-.707 10.293-10.293-10.293-10.293.707-.707 10.293 10.293z"></path></svg>',
					closeButtonPosition: '.popup-page-body',
					clickout: true,
					clickoutTarget: '.popup-page-body',
					reactTarget: 'body',
					reactActiveClass: 'active-project-status-guide',
					activeCallBack: function() {
						$('.project-status-guide').find('.popup-local-body').scrollTop(0);
					},
				});
			}
		}
	});

	function lf_getNoticeList() {
		$.ajax({
			url : "/notice/ajax/getNoticeAlarmListAjax"
			,dataType : "html"
			,cache : false
			,success : function(data) {
				$("#noticePopup").append(data);
			}
		});
	}

	$(function() {
		var isMobile = 'false';
		var isApp = 'false';
		var userAgentAndroid = /Android/i.test(navigator.userAgent);

		if (isMobile == 'true' && isApp == 'false'){
			if (userAgentAndroid) {
				$(".page-body").addClass("app-install-wrap");
			}
		}
		lf_getNoticeList();
	});

	//안드로이드 배너 클릭시 앱링크 이동
	function lf_appLink() {
		var requestURL = 'http://www.talentbank.co.krexperts.html';
		setTimeout(function() {
			location.href = "intent://openurl?randingUrl=" + requestURL + "#Intent;scheme=talentbank;package=kr.co.hunet.talentbank;end";
		}, 1000);
	}

	function lf_searchAuto(keyword, type) {
		var searchValue = "";
		if(type == 'srchValueAuto') {
			searchValue = $("input[name='searchValue']").val();
		} else if(type == 'localSearchKeyword') {
			searchValue = $("#localSearchKeyword-2").val();
		}

		if(searchValue != undefined && searchValue != '') {
			$.ajax({
				url : "/common/ajax/autoKeyword"
				,data : { keyword : keyword }
				,dataType : "json"
				,contentType : "application/json"
				,cache : false
				,success : function(data) {
					var html = "";
					if(data != null && data.length > 0) {
						$(data).each(function(i, v) {
							html += `<button type="button" class="item" onclick="lf_goSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							//html += "<button type=\"button\" class=\"item\" onclick=\"lf_goExpertSearchListPage('" + v.profileTitle + "');\">" + v.highlightProfileTitle + "</button>";
						});

						if(type == 'srchValueAuto') {
							$("#autoSearchExpert").css("display","block");
							$(".main-search-drop").css("display","none");

						} else if(type == 'localSearchKeyword') {
							$("#autoSearchExpertMo").css("display","block");
							$(".main-search-drop").css("display","none");
						}
					} else {
						html = "";
						if(type == 'srchValueAuto') {
							$("#autoSearchExpert").css("display","none");
						} else if(type == 'localSearchKeyword') {
							$("#autoSearchExpertMo").css("display","none");
						}
					}
					if(type == 'srchValueAuto') {
						$("#autoSearchExpert").html(html);
					} else if(type == 'localSearchKeyword') {
						$("#autoSearchExpertMo").html(html);
					}
				}
			});
		} else {
			if(type == 'srchValueAuto') {
				$("#autoSearchExpert").css("display", "none");
				$("#autoSearchExpert").html(""); // (이전 검색 기록에 대한)자동완성 제거
			} else if(type == 'localSearchKeyword') {
				$("#autoSearchExpertMo").css("display", "none");
				$("#autoSearchExpertMo").html(""); // (이전 검색 기록에 대한)자동완성 제거
			}
		}
	}

	function lf_searchExpertAuto(keyword, type) {
		var searchValue = "";
		if(type == 'srchValueAuto') {
			searchValue = $("input[name='searchValue']").val();
		} else if(type == 'localSearchKeyword') {
			searchValue = $("#localSearchKeyword-2").val();
		}
		// 검색 타입(전문가, 상품, 공고, 온자)에 따른 분기 처리
		const searchFilter = $(".local-search-main .main-search-drop a");
		let searchFilterIdx;
		for (var i =0; i<searchFilter.length; i++){
			if (searchFilter[i].className.indexOf("on") > 0){
				searchFilterIdx = i;
			}
		}
		if(searchValue != undefined && searchValue != '') {
			$.ajax({
				url : "/common/ajax/autoKeyword"
				,data : { keyword : keyword }
				,dataType : "json"
				,contentType : "application/json"
				,cache : false
				,success : function(data) {
					var html = "";
					if(data != null && data.length > 0) {
						$(data).each(function(i, v) {
							if (searchFilterIdx == 0) {
								html += `<button type="button" class="item" onclick="lf_goExpertSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							} else if (searchFilterIdx == 1) {
								html += `<button type="button" class="item" onclick="lf_goProjectProductSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							} else if (searchFilterIdx == 2) {
								html += `<button type="button" class="item" onclick="lf_goProjectSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							} else if (searchFilterIdx == 3) {
								html += `<button type="button" class="item" onclick="lf_goConsultSearchListPage('${v.keyword}')">${v.highLightKeyword}</button>`;
							}
							//html += "<button type=\"button\" class=\"item\" onclick=\"lf_goExpertSearchListPage('" + v.profileTitle + "');\">" + v.highlightProfileTitle + "</button>";
						});
						if(type == 'srchValueAuto') {
							$("#autoSearchExpert").css("display","block");
							$(".main-search-drop").css("display","none");

						} else if(type == 'localSearchKeyword') {
							$("#autoSearchExpertMo").css("display","block");
							$(".main-search-drop").css("display","none");
						}
					} else {
						html = "";
						if(type == 'srchValueAuto') {
							$("#autoSearchExpert").css("display","none");
						} else if(type == 'localSearchKeyword') {
							$("#autoSearchExpertMo").css("display","none");
						}
					}
					if(type == 'srchValueAuto') {
						$("#autoSearchExpert").html(html);
					} else if(type == 'localSearchKeyword') {
						$("#autoSearchExpertMo").html(html);
					}
				}
			});
		} else {
			if(type == 'srchValueAuto') {
				$("#autoSearchExpert").css("display", "none");
				$("#autoSearchExpert").html(""); // (이전 검색 기록에 대한)자동완성 제거
			} else if(type == 'localSearchKeyword') {
				$("#autoSearchExpertMo").css("display", "none");
				$("#autoSearchExpertMo").html(""); // (이전 검색 기록에 대한)자동완성 제거
			}
		}
	}

	function lf_goSearchListPage(val) {
		sessionStorage.expertScrollTop = 0;
		location.href = "search.html?searchValue=" + encodeURIComponent(val);
	}

	function lf_goExpertSearchListPage(val) {
		sessionStorage.expertScrollTop = 0;
		if ($("#localSearchKeyword").hasClass("client")) {
			location.href = "experts.html?searchValue=" + encodeURIComponent(val);
		}else if ($("#localSearchKeyword").hasClass("expert")) {
			location.href = "/common/project/projectSearch?searchValue=" + encodeURIComponent(val);
		}
	}

	function lf_goProjectSearchListPage(val) {
		location.href = "/common/project/projectSearch?searchValue=" + encodeURIComponent(val);
		sessionStorage.projectSearchScrollTop = 0;
	}

	function lf_goProjectProductSearchListPage(val) {
		location.href = "/common/productSearchList?searchValue=" + encodeURIComponent(val);
		sessionStorage.productListScrollY = 0;
	}

	function lf_goConsultSearchListPage(val) {
		location.href = "/common/consult-list?searchValue=" + encodeURIComponent(val);
		sessionStorage.projectSearchScrollTop = 0;
	}


	function lf_test(){
		if($("#solutionDepth").length > 0){
			$("#solutionDepth").attr("href", "stories.html");
		}

		//if($('.solution-depth').is(":visible")){
			$(".mSolutionTab").attr("id","solutionDepth");
		//}

	}

	function lf_selectTab() {
		var serviceType = "";
		if(serviceType == 'expert'){
			gf_expertAlert();
		} else {
			gf_forClientNotice();
		}
	}

	//로그인 상태 확인
	function lf_chkLogin(type) {
		var serviceType = "";
		if(serviceType != ''){
			gf_openToastDefault("이미 가입하신 회원입니다.");
		} else {
			if(type == 'client'){
				location.href = "signup.html?type=client";
			} else {
				location.href = "signup.html?type=expert";
			}
		}
	}

	//바로가기
	function lf_mCheck() {
		
			
			
				$("#confirmBtn2").removeClass();
				$("#confirmBtn2").addClass("btn btn-client");

				gf_confirmOpen("회원만 이용할 수 있습니다.<br>로그인 후 이용하시겠습니까?","로그인하기");
				$("#confirmBtn2").click(function() {
					location.href = "login.html?serviceTypeCode=SVC_TY002";
				});
			
		
	}

	// 새로운 알림이 있는지 검사...
	var newAlarm = false;
	$.ajax({
		url : "/common/ajax/selectNewAlarmCnt"
		,data : {}
		,dataType : "json"
		,contentType: "application/json"
		,cache : false
		,success : function(data) {
			if(data.result_code == "SUCCESS" && data.resultValue01 == "Y") {
				$("#msgNewDiv").css("display", "block");
				$("#messageManage").addClass("active update");
				newAlarm = true;
			}else{
				$("#msgNewDiv").css("display", "none");
				$("#messageManage").removeClass("active update");
			}
		}
	});

	$("#accountArea").click(function() {
		if($(".client-side-login").hasClass("active")){
			$("#msgNewDiv").css("display", "none");
		}
	});

	$(document).mouseup(function (e) {
		if(newAlarm){
			var container = $("#msgNewDiv");
			if (container.has(e.target).length == 0) {
				if(!false){
					container.show();
				}
			}
		}
	});

	function lf_solutionCntChk(){
		var solutionCnt = "";
		if(solutionCnt < 5){
			location.href = "/expert/profile/solutionRegForm";
		} else {
			gf_openToastDefault("Expert's 제안은 최대 5개까지 등록 가능해요.");
		}
	}

	function lf_newNonMemberSearchSession(seq) {
		var chk = true;

		// 누락항목 체크
		$(".empty").each(function(i, v) {
			$(this).removeClass("empty");
		});

		var email = $("#firstEmail" + seq).val()+"@"+$("#lastEmail" + seq).val();
		if (!gf_emailChk(email)) {
			$(".mail-input-box").addClass("empty");
			$(".empty-txt").show();

			chk = false;
		}

		var agreeChk = $("#terms5" + seq).is(":checked");
		if (!agreeChk) {
			gf_openToastDefault("개인정보 이용에 동의해주세요.");
			chk = false;
		}

		if(chk){
			// 저장 ajax
			var email = $("#firstEmail" + seq).val()+"@"+$("#lastEmail" + seq).val();
			$("#email" + seq).val(email);

			var nonMemberParam = {
				userSearchedSeq : 0
				,firstJobFieldCode : $("#firstJobFieldCode" + seq).val()
				,secondJobFieldCode : $("#secondJobFieldCode" + seq).val()
				,servicePaymentHourPriceCode : $("#servicePaymentHourPriceCode" + seq).val()
				,servicePaymentDayPriceCode : $("#servicePaymentDayPriceCode" + seq).val()
				,searchTag : $("#searchTag" + seq).val()
				,searchValue : $("#searchValue" + seq).val()
				,email : $("#email" + seq).val()
			};

			$.ajax({
				 url : "/common/ajax/insertNewExpertAlarm"
				,method : "POST"
				,data : nonMemberParam
				,dataType : "json"
				,success : function(data) {
					if(data.result_code == 'SUCCESS') {
						gf_openToastDefault("New 전문가 소식받기가 완료되었어요!");

						// 검색 히스토리 쿠키 삭제(유효기간을 바로 만료시킴)
						//document.cookie = seq + '=' + escape("-1");
						setCookie(seq,'','-1');
					} else if(data.result_code == 'FAIL') {
						gf_checkPopup("동일한 신청 내역이 있어요", "해당 검색 조건으로 이미 알람을 신청하셨습니다. ", "", "확인", "sorry");
						$("#popBtn2").off().on('click', gf_confirmPopClose);
					}

					$("#nonUserNewExpertAlarm" + seq).hide();
				}
			});
		}
	}

	//자동완성 밖 클릭시 드롭다운 none
	$("body").click(function() {
		$("#autoSearchExpert").css("display", "none");
	});

///////////////////////////////////////////
	var isApp = false;
	function lf_goView(alarmSeq, linkUrl, alarmType) {
		$.ajax({
			url : "/notice/ajax/updateAlarmViewDate"
			,data : {
				alarmSeq : alarmSeq
				,alarmType : alarmType
			}
			,dataType : "json"
			,contentType: "application/json"
			,cache : false
			,success : function(data) {
				if(linkUrl != "") {
					// App Badge 카운트 수정함
					if (isApp) {
						lf_readMsg(alarmSeq, 0);
					}
					location.href = linkUrl;
				} else {
					location.reload(true);
				}
			}
		});
	}

	function lf_readAllAlarm() {
		$.ajax({
			url : "/notice/ajax/updateViewAllAlarm"
			,dataType : "json"
			,contentType: "application/json"
			,cache : false
			,success : function() {
				$(".notice-list-wrap li").addClass("read");
				$(".num").css('display', 'none');
			}
		});
	}
</script>


