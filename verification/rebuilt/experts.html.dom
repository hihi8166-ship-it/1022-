	$(function() {
		$('.local-search-v3 .elem').on('input propertychange', function() {
			var $this = $(this);
			var visible = Boolean($this.val());
			$this.siblings('.form-control-clear').toggleClass('hidden', !visible);
		}).trigger('propertychange');

		$('.local-search-v3 .form-control-clear').click(function() {
			$(this).siblings('.elem').val('').trigger('propertychange').focus();
		});
	});
</script>
