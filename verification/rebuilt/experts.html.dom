						<a href="expert.html?userSeq=3248">
							<!-- posts-head -->
							<div class="posts-head">
								<div class="posts-name">
									<span class="text">기업 자금조달,  PF 전문가</span>
								</div>
								<div class="posts-info">
									<div class="info-area">
										
											<span class="info-item expert-field">
													재무/투자
											</span>
										
