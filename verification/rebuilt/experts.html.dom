<script type="text/javascript">
/**
 * 토스트팝업 띄우기
 * @param toastNum : 팝업 타입 (1~7)
 * @param bodyMsg : 내용
 * @param btnTxt : 버튼 텍스트
 * @param fadeOutTime : 팝업 노출 시간(단위 : ms)
 */
function gf_openToastFinal(toastNum, bodyMsg, btnTxt, btnLink, fadeOutTime) {
	// console.log("toast final");
	// console.log(" - toastNum : " + toastNum);
	// console.log(" - bodyMsg : " + bodyMsg);

	// toast팝업 테스트
	// $('#pop_tost_a007').show();
	// $('#pop_tost_a007').delay(2000).fadeOut();

	if (toastNum == '1') {
		$('#pop_tost_a00' + toastNum + " .scrap-view").html(btnTxt);
		//$('#pop_tost_a00' + toastNum + " .scrap-view").attr("href", btnLink);
	}
	$('#pop_tost_a00' + toastNum + " .print-txt").html(bodyMsg);
	$('#pop_tost_a00' + toastNum).show();
	$('#pop_tost_a00' + toastNum).delay(fadeOutTime).fadeOut();
}

// 팝업창 띄우기
function gf_openToastBtntxt(toastNum, bodyMsg, btnTxt, fadeOutTime) {
	// console.log(4);
	var btnLink = "#none";
	gf_openToastFinal(toastNum, bodyMsg, btnTxt, btnLink, fadeOutTime)
}

//팝업창 띄우기
function gf_openToastFadeout(toastNum, bodyMsg, fadeOutTime) {
	// console.log(3);
	var btnTxt = "스크랩 전문가 보기"; // 기본 버튼명
	gf_openToastBtntxt(toastNum, bodyMsg, btnTxt, fadeOutTime)
}

// 팝업창 띄우기
function gf_openToast(toastNum, bodyMsg) {
	// console.log(2);
	gf_openToastFadeout(toastNum, bodyMsg, 2500);
}

// 기본 토스트 팝업 띄우기
function gf_openToastDefault(bodyMsg) {
	// console.log("1 ---> " + bodyMsg);
	gf_openToast('7', bodyMsg);
}

// 토스트 팝업 닫기
$('.expert-scrap-toast .close').on('click', function(){
	$('.toast-pop-wrap').hide();
});
</script>

