<script type="text/javascript">
	$(function() {
		$('.integration-search-wrap .tabs ul .tab-item').on('click' , function(){
			var tabIndex = $(this).index();
			$('.integration-search-wrap .tabs ul .tab-item').removeClass('active');
			$(this).addClass('active');
			targetAction(tabIndex);
		});

		if ($('.integration-search-wrap .tabs ul .tab-item').hasClass('active')) {
			var tabIndex =$('.integration-search-wrap .tabs ul .tab-item.active').index();
			targetAction(tabIndex);
		};

		function targetAction(itemIdex) {
			var tScrollX = $('.integration-search-wrap .tabs ul').find('.tab-item').eq(itemIdex).offset().left + $('.integration-search-wrap .tabs ul').scrollLeft() + -$(window).width() / 2 + $('.integration-search-wrap .tabs ul').find('.tab-item').eq(itemIdex).width() / 2;
			tScrollX <= 0 ? 0 : tScrollX;
			parseInt(tScrollX) !== $('.integration-search-wrap .tabs ul').scrollLeft() && ($('.integration-search-wrap .tabs ul').stop().animate({ scrollLeft: tScrollX }, 500))
		}
	});

	//TB 추천 전문가
	var tbRecommendList = new Swiper(
			'#strategy-area .swiper-container',
			{
				speed: 500,
				spaceBetween: 24,
				slidesPerView: 4,
				slidesPerGroup: 1,
				navigation: {
					nextEl: '#strategy-area .swiper-button-next',
					prevEl: '#strategy-area .swiper-button-prev',
				},
				observer: true,
				observeParents: true,
				breakpoints: {
					991: {
						noSwiping: false,
						centeredSlides: true,
						spaceBetween: 10,
						slidesPerView: 'auto',
					},
				},
			}
	);

	//검색 시, 전문분야 선택 시 TB추천 전문가 숨김
	/*$.urlParam = function (name) {
		var results = new RegExp('[\?&]' + name + '=([^&#]*)').exec(window.location.href);
		if (results==null) {
			return null;
		} else {
			return results[1] || 0;
		}
	}
	const keyword = $.urlParam('keyword3');
	const secondJobFieldCode = $.urlParam('secondJobFieldCode');
	const tbRecommendArea = document.getElementById("tbRecommendArea")
	if (keyword || secondJobFieldCode) {
		tbRecommendArea.classList.add('hiddenArea')
	}*/

</script>

<script type="text/javascript">
	let sortType = '';
	let sortColumn = '';
	let sortDirection = '';
	let searchVal = '';
	let secondJobFieldCode = '';
	let paramFieldCode = '';
	let detailSearchVal = '';
	let pDetailSearchVal = '';
	let pageNo = $("#expertpageNo").val();
	let serviceType = '';
	let firstJobFieldNm = "";
	let secondJobFieldNm = "";

	//재검색 div
	if(pDetailSearchVal != ''){
		let detailToArray = pDetailSearchVal.split(" ");
		for(let i = 0; i < detailToArray.length; i++) {
			let html = '<p class="piece">' + detailToArray[i] + '<a href="javascript:void(0);" onclick="lf_deleteSrchCondition(this);" class="del"></a></p>';
			$(".detail-list-box").append(html);
			if ($("#detailDiv").css("display") == "none") {
				$("#detailDiv").css("display", "flex");
			}
		}
	}

	//결과 내 재검색
	function lf_detailSearch() {
		debugger;
		const detailArr = $(".detail-list-box .piece");
		let detailChk = true;
		if($("#keywordDetail").val().trim() == ""){
			gf_openToastDefault("결과 내 재검색 키워드를 입력하세요.");
		} else {
			//재검색 키워드 chk
			for(item of detailArr){
				if($(item).text() == $("#keywordDetail").val()){
					detailChk = false;
				}
			}

			//통합검색 키워드 chk
			if( searchVal == $("#keywordDetail").val()){
				detailChk = false;
			}

			if (detailArr.length < 3) {
				if(!detailChk){
					gf_openToastDefault("이미 검색한 키워드를 입력하였습니다.");
				} else {
					let html = '<p class="piece">' + $("#keywordDetail").val() + '<a href="javascript:void(0);" onclick="lf_deleteSrchCondition(this);" class="del"></a></p>';
					$(".detail-list-box").append(html);
					if ($("#detailDiv").css("display") == "none") {
						$("#detailDiv").css("display", "flex");
					}
					$("#keywordDetail").val('');
					pageNo = 1;
					lf_searchList(true); // 전체검색
				}
			} else {
				gf_openToastDefault("검색 가능 제한 개수(3개)를 초과하였습니다.");
			}
		}
	}

	//결과 내 재검색 삭제
	function lf_deleteSrchCondition(ele) {
		$(ele).parent().remove();

		//재검색 박스 체크
		var pLength = $(".piece").length;
		if(pLength <= 0) {
			$("#detailDiv").css("display", "none");
		}
		pageNo = 1;
		lf_searchList(true); // 검색
	}

	// 검색
	function lf_searchList(initFlag, type) {
		gf_showSearchSpinner();
		// 페이지 set.
		$("#expertPageNo").text(pageNo);

		if(sortType == "") sortType = "sortType00";
		if(sortColumn == "") sortColumn = "tb_referral_confirm_type_code";
		if(sortDirection == "") sortDirection = "desc";

		// 결과 내 재검색
		detailSearchVal = "";
		$(".piece").each(function(i, v){
			detailSearchVal += $(v).text() + " ";
		});
		detailSearchVal = detailSearchVal.trim();

		searchParam = {
			sortType 								: sortType
			,pageNo  								: pageNo
			,serviceType 							: serviceType
			,firstJobFieldCode  					: ''
			,secondJobFieldCode 					: secondJobFieldCode
			,servicePaymentHourPriceCode 			: ''
			,servicePaymentDayPriceCode  			: ''
			,searchTag   							: ''
			,searchValue 							: searchVal
			,initFlag    							: initFlag
			,keywordFilter							: ''
			,keywordDetail							: detailSearchVal
			,sortColumn								: sortColumn
			,sortDirection							: sortDirection
		};

		// 전문가 검색(+ 건수)
		$.ajax({
			url : "/common/ajax/expertSearchListAjax"
			,type : "POST"
			,data : searchParam
			,dataType : "html"
			,success : function(data) {
				// 공통 Error 처리가 된다면 기존페이지에 globalError.jsp 페이지가 append 가 되어 화면이 깨짐
				// So, globalError 페이지의 'SYSTEM ERROR' 문구를 확인하여 에러 alert을 팝업
				if(!data.match('class="local-name">SYSTEM ERROR')) {

					if(secondJobFieldCode != ''  || $("#searchVal").text() != ''){
						$("#strategy-area").css("display", "none");
					} else {
						$("#strategy-area").css("display", "block");
					}

					if(initFlag == true){
						$("#expertSearchUL").html(data);
					} else {
						$("#expertSearchUL").append(data);
					}
					lf_setScroll();
				} else{
					$("#expertListCnt").text("0");
					$("#expertErrDataDiv").css("display", "block");
					$("#expertSearchUL").css("display", "none");
					$("#expertNoDataDiv").css("display", "none");
				}
				gf_hideSearchSpinner();
			}
			,error : function() {
				$("#expertListCnt").text("0");
				$("#expertErrDataDiv").css("display", "block");
				$("#expertSearchUL").css("display", "none");
				$("#expertNoDataDiv").css("display", "none");
				gf_hideSearchSpinner();
			}
		});

		//history replace
		history.replaceState(null, "", location.href.split("?")[0]+"?searchValue=" + searchVal + "&sortType=" + sortType +"&sortColumn=" + sortColumn + "&sortDirection=" + sortDirection + "&keywordDetail=" + detailSearchVal + "&secondJobFieldCode=" + secondJobFieldCode);

	}

	if(typeof(history.replaceState) == "function") {
		history.replaceState(null, "", location.href.split("?")[0]+"?searchValue=" + searchVal + "&sortType=" + sortType + "&sortColumn=" + sortColumn + "&sortDirection=" + sortDirection + "&keywordDetail=" + detailSearchVal + "&secondJobFieldCode=" + secondJobFieldCode);
		// 뒤로가기 감지 후 스크롤 이동
		//window.scrollTo(0, sessionStorage.getItem('expertConsultProductListScrollY'));
	}

	$(function() {

		lf_init();

	});

	// 뒤로가기로 돌아왔을 때 감지
	if (window.performance.navigation.type == 2) {
		pageNo = sessionStorage.getItem('expertPageNo');
		window.scrollTo(0, sessionStorage.getItem('expertPageScrollY'));
	} else {
		scrollInit = true;
		pageNo = 1;
		lf_setScroll();
	}

	// 다른 페이지 이동시 세션 스토리지 저장(뒤로가기 시 히스토리 기억)
	window.addEventListener('beforeunload', function() {
		sessionStorage.setItem('expertPageNo', pageNo); // 현재 페이지
		sessionStorage.setItem('expertPageScrollY', window.scrollY); // 스크롤 위치
	});

	function lf_init() {
		$('html').scrollTop(0);
		//pageNo = sessionStorage.getItem('expertPageNo');
		if(pageNo == '' || pageNo == undefined || isNaN(pageNo)) {
			pageNo = 1;
		}

		// 이미 검색된 전문분야 코드가 있다면 div set.
		if(paramFieldCode != ""){
			// 이미 검색된 전문상세분야의 1depth 분야 체크후 리스트 set.
			let pField = paramFieldCode.substr(0, 8);
			lf_selectJobField(pField, '', paramFieldCode);
			lf_selectJobField_M('', pField, '', paramFieldCode);
		} else {
			lf_searchList(true); // 검색
		}
	}

	// 처음 스크롤 위치 지정 이후에는 초기화 하지 않음
	var scrollInit = true;
	function lf_setScroll() {
		if (scrollInit) {
			$(document).scrollTop(sessionStorage.expertPageScrollY);
			scrollInit = false;
		}
	}

	//전문분야 재검색
	function lf_selectJobField(parentJobField, ele, param) {
		if(ele != ''){
			//상세분야 list 선택시
			pageNo = 1;
			$(ele).parent().siblings('li').removeClass("active");
			$(ele).parent().addClass("active"); // 선택값만 active
		} else {
			//상세분야 파라미터로 넘어왔을 경우
			const fieldLI = document.querySelectorAll("[data-jobfield]");
			fieldLI.forEach((e, i) => {
				$(e).removeClass("active");
				if($(e).data("jobfield") == parentJobField){
					$(e).addClass("active");
					$(e)[0].scrollIntoView({block: 'center'});
				}
			});
		}

		if(parentJobField == ''){
			//전문분야 전체선택
			$("#detailFieldDiv").css("display", "none");
			secondJobFieldCode = '';
			lf_searchList(true); // 검색
		} else {
			//전문분야 선택이 들어갔을때
			$.ajax({
				url : "/common/ajax/getJobField2List?parentJobFieldCode="+parentJobField
				,method : "get"
				,dataType : "json"
				,contentType: "application/json"
				,cache : false
				,success : function(data) {
					var str = "";
					$(data).each(function(i, v) {
						if(param != ''){
							//검색된 전문분야코드가 존재할때 해당분야 자동검색
							if(v.jobFieldCode == param){
								str += "<li class='active' data-jobfield=''><a href='javascript:void(0)' onclick='lf_selectDetailJobField(\"" + v.jobFieldCode + "\",this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
								secondJobFieldCode = v.jobFieldCode;
								lf_searchList(true); // 검색
							} else {
								str += "<li><a href='javascript:void(0)' onclick='lf_selectDetailJobField(\""+ v.jobFieldCode + "\",this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
							}
						} else {
							if(i==0) {
								//1depth 분야를 선택했을 경우 2depth 상세전체분야를 자동검색
								str += "<li class='active'><a href='javascript:void(0)' onclick='lf_selectDetailJobField(\"" + v.jobFieldCode + "\",this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
								secondJobFieldCode = v.jobFieldCode;
								lf_searchList(true); // 검색
							} else {
								str += "<li><a href='javascript:void(0)' onclick='lf_selectDetailJobField(\""+ v.jobFieldCode + "\",this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
							}
						}
					});
					$('[id^="detailFieldUL_pc"]').html(str);
					$("#detailFieldDiv").css("display", "block");

					//통합검색 전문분야 선택 스크롤 PC
					var chkList = $(".category-section .check-list , .category-popup .check-list").eq(0);
					var activeIdx = chkList.find("li.active").index();
					var FieldHeight =  chkList.find("li").height();
					chkList.animate({scrollTop: activeIdx * FieldHeight }, 1000);
					chkList.find(".scroll").animate({scrollTop: activeIdx * FieldHeight }, 1000);
				}
				,error : function(data) {
					gf_checkPopup("오류가 발생했어요","잠시 후 다시 이용해주세요.<br>계속해서 오류가 발생하면<br>고객센터(tbhelp@talentbank.co.kr)로 연락해주세요.","","확인", "sorry");
					$("#popBtn2").off().on('click', gf_confirmPopClose);
				}
			});
		}
	}

	//상세분야 재검색
	function lf_selectDetailJobField(field, ele){
		if(ele != ''){
			$(ele).parent().siblings('li').removeClass("active");
			$(ele).parent().addClass("active"); // 선택값만 active
		}
		secondJobFieldCode = field;
		pageNo = 1;
		lf_searchList(true); // 검색
	}

	//정렬 재검색
	function lf_sortList(sortVal){

		if(sortVal == "sortType01"){
			//평점높은순
			sortType = "sortType01";
			sortColumn = "expert_rating";
			sortDirection = "desc";
		} else if(sortVal == "sortType02"){
			//평점개수많은순
			sortType = "sortType02";
			sortColumn = "rating_cnt";
			sortDirection = "desc";
		} else if(sortVal == "sortType03"){
			//표준대금 낮은순 (1시간)
			sortType = "sortType03";
			sortColumn = "project_wish_price_hours";
			sortDirection = "asc";
		} else if(sortVal == "sortType04"){
			//표준대금 낮은순 (1일)
			sortType = "sortType04";
			sortColumn = "project_wish_price_day";
			sortDirection = "asc";
		} else {
			//정확도순
			sortType = "sortType00";
			sortColumn = "_score";
			sortDirection = "desc";
		}
		lf_searchList(true); // 검색
	}

	//전문분야 초기화
	function lf_clearField(){
		secondJobFieldCode = '';
		$("#fieldLI").siblings('li').removeClass("active");
		$("#fieldLI").addClass("active");
		$("#detailFieldDiv").css("display", "none");

		// 검색리스트 화면 세션스토리지 초기화
		gf_globalVariableInit();
		pageNo = 1;
		lf_searchList(true); // 검색
	}

	//스크랩 모아보기
	function lf_scrapViewAll(){
		if('N' == 'Y') {
			if('' == 'SVC_TY002') {
				location.href = "/common/scrapCollection";
			} else {
				gf_openToastDefault("Client만 이용 가능한 서비스에요.");
			}
		} else {
			gf_forClientNotice();
		}
	}

	//더보기 (페이지 번호를 올려서 검색)
	function lf_more() {
		var pageNum = parseInt($("#expertPageNo").text());
		var totPageNo = parseInt($("#expertTotPageNo").text());
		pageNum++;

		if(pageNum <= totPageNo) {
			sessionStorage.expertPageNo = pageNum;
			$("#expertPageNo").text(pageNum);
			pageNo = pageNum;
			lf_searchList(false, "MORE");
		}
	}

	//모바일 전문분야 재검색 List Set
	function lf_selectJobField_M(parentFieldNm, parentFieldCd, ele, param) {
		if(ele != ''){
			//상세분야 list 선택시
			pageNo = 1;
			$(ele).parent().siblings('li').removeClass("active");
			$(ele).parent().addClass("active"); // 선택값만 active
		} else {
			//상세분야 파라미터로 넘어왔을 경우
			const fieldLI = document.querySelectorAll("[data-jobfield]");
			fieldLI.forEach((e, i) => {
				$(e).removeClass("active");
				if($(e).data("jobfield") == parentFieldCd){
					$(e).addClass("active");
					parentFieldNm = $(e).children().text();
				}
			});
		}

		//전문분야 선택이 들어갔을때
		$.ajax({
			url : "/common/ajax/getJobField2List?parentJobFieldCode="+parentFieldCd
			,method : "get"
			,dataType : "json"
			,contentType: "application/json"
			,cache : false
			,success : function(data) {
				var str = "";
				$(data).each(function(i, v) {
					if(param != ''){
						//검색된 전문분야코드가 존재할때 해당분야 자동검색
						if(v.jobFieldCode == param){
							str += "<li class='active'><a href='javascript:void(0)' onclick='lf_selectDetailJobField_M(\"" + v.jobFieldCode + "\",\"상세분야 전체 선택\" ,this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
							firstJobFieldNm = parentFieldNm;
							secondJobFieldNm = v.jobFieldNm;
							secondJobFieldCode = v.jobFieldCode;
							$("#categoryTxt").text(firstJobFieldNm + " > " + secondJobFieldNm);
							$("#categoryBtn").text("변경");
							lf_searchList(true); // 검색
						} else {
							str += "<li><a href='javascript:void(0)' onclick='lf_selectDetailJobField_M(\"" + v.jobFieldCode + "\",\"" + v.jobFieldNm + "\" ,this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
						}
					} else {
						if (i == 0) {
							str += "<li class='active'><a href='javascript:void(0)' onclick='lf_selectDetailJobField_M(\"" + v.jobFieldCode + "\",\"상세분야 전체 선택\" ,this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
							firstJobFieldNm = parentFieldNm;
							secondJobFieldNm = "상세분야 전체 선택";
							secondJobFieldCode = v.jobFieldCode;
						} else {
							str += "<li><a href='javascript:void(0)' onclick='lf_selectDetailJobField_M(\"" + v.jobFieldCode + "\",\"" + v.jobFieldNm + "\" ,this);' value='" + v.jobFieldCode + "'>" + v.jobFieldNm + "</li>";
						}
					}
				});
				$('[id^="detailFieldUL_mo"]').html(str);

				//통합검색 전문분야 선택 스크롤 mobile
				var MchkList = $(".category-popup .check-list").eq(0).find(".scroll");
				var MactiveIdx = MchkList.find("li.active").index();
				var MFieldHeight =  MchkList.find("li").height();
				MchkList.animate({scrollTop: MactiveIdx * MFieldHeight }, 1000);
			}
			,error : function(data) {
				gf_checkPopup("오류가 발생했어요","잠시 후 다시 이용해주세요.<br>계속해서 오류가 발생하면<br>고객센터(tbhelp@talentbank.co.kr)로 연락해주세요.","","확인", "sorry");
				$("#popBtn2").off().on('click', gf_confirmPopClose);
			}
		});
	}

	//모바일 상세분야 재검색 List Set
	function lf_selectDetailJobField_M(fieldCd, fieldNm, ele){
		if(ele != ''){
			$(ele).parent().siblings('li').removeClass("active");
			$(ele).parent().addClass("active"); // 선택값만 active
		}
		secondJobFieldNm = fieldNm;
		secondJobFieldCode = fieldCd;
	}

	//모바일 전문분야 검색시작 선택
	function  lf_jobFieldSearchList(){
		$("#categoryTxt").text(firstJobFieldNm + " > " + secondJobFieldNm);
		$("#categoryBtn").text("변경");

		pageNo = 1;
		lf_searchList(true);
		$("body").removeClass("active-category-popup-jobfield");
	}

	//조건 초기화
	function  lf_clearSearch(){
		// 검색리스트 화면 세션스토리지 초기화
		gf_globalVariableInit();
		location.href = "experts.html";
	}

	$(document).on("click", "input[name='expertScrap']", function () {

		if('N' == 'Y') {
			if('' == 'SVC_TY002') {
				var expertSeq = $(this).attr("id").replace("expertScrap", "");
				var chked = $(this).is(":checked") ? "Y" : "N";

				lf_expertScrapFnc(chked, expertSeq);
			} else {

				if($(this).parent().find('input[type="checkbox"]').is(':checked')){
					$(this).parent().find('input[type="checkbox"]').prop("checked", false);
				}

				gf_openToastDefault("Client만 이용 가능한 서비스에요.");
			}
		} else {

			if($(this).parent().find('input[type="checkbox"]').is(':checked')){
				$(this).parent().find('input[type="checkbox"]').prop("checked", false);
			}

			gf_forClientNotice();
		}

	});

	function lf_expertScrapFnc(isScrap, scrapExpertSeq) {
		$.ajax({
			url : "/common/ajax/expertScrapAjax"
			,method : "POST"
			,data : {
				isScrap : isScrap
				,scrapExpertSeq : scrapExpertSeq
			}
			,dataType : "json"
			,success : function(data) {
				if(isScrap == 'Y') {
					gf_openToast(1, "전문가님이 스크랩되었습니다.")
				} else {
					gf_openToastDefault("스크랩이 해제되었습니다.");
				}
			}
		});
	}

	//자문 요청
	function lf_requiredCounsel(userSeq, counselType){
		if('N' == 'Y') {
			if('' == 'SVC_TY002') {
				location.href = "expert.html?userSeq="+userSeq+"&counselType=" + counselType;
			} else {
				gf_openToastDefault("Client만 이용 가능한 서비스에요.");
			}
		} else {
			gf_forClientNotice();
		}
	}

	//메인 키워드 검색
	function lf_selectDisplayKeyword(keyword){
		$("#searchValue").val(keyword)
		$("#searchForm").submit();
	}
</script>


